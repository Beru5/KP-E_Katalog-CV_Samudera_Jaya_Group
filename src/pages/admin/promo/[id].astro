---
// @ts-nocheck
export const prerender = false;
import { pool } from '../../../lib/db.js';
import fs from 'node:fs';
import path from 'node:path';

const sessionId = Astro.cookies.get('admin_session')?.value;
if (!sessionId) return Astro.redirect('/admin/login');

const { id } = Astro.params;
let errorMessage = '';

const [rows] = await pool.query('SELECT * FROM Promo WHERE promo_id = ?', [id]);
if (rows.length === 0) return Astro.redirect('/admin/promo');
const promo = rows[0];

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    
    const promo_judul = formData.get('promo_judul')?.toString().trim();
    const promo_kategori = formData.get('promo_kategori')?.toString().trim();
    const promo_mulai = formData.get('promo_mulai')?.toString().trim();
    const promo_berakhir = formData.get('promo_berakhir')?.toString().trim();
    const promo_deskripsi = formData.get('promo_deskripsi')?.toString().trim();

    if (!promo_judul || !promo_kategori || !promo_mulai || !promo_berakhir) {
      throw new Error("Judul, Kategori, Tanggal Mulai, dan Tanggal Berakhir wajib diisi.");
    }

    const imageFile = formData.get('promo_gambar');
    let promo_gambar_path = promo.promo_gambar;

    if (imageFile && typeof imageFile === 'object' && imageFile.size > 0) {
      const uploadDir = path.resolve('./public/uploads/promo');
      if (!fs.existsSync(uploadDir)) {
        fs.mkdirSync(uploadDir, { recursive: true });
      }
      const buffer = Buffer.from(await imageFile.arrayBuffer());
      const fileName = `promo-${Date.now()}-${imageFile.name.replace(/\s+/g, '_')}`;
      fs.writeFileSync(path.join(uploadDir, fileName), buffer);
      promo_gambar_path = `/uploads/promo/${fileName}`;
    }

    await pool.query(`
      UPDATE Promo 
      SET promo_judul = ?, promo_kategori = ?, promo_mulai = ?, promo_berakhir = ?, promo_gambar = ?, promo_deskripsi = ?
      WHERE promo_id = ?
    `, [promo_judul, promo_kategori, promo_mulai, promo_berakhir, promo_gambar_path, promo_deskripsi, id]);

    return Astro.redirect('/admin/promo');
  } catch (err) {
    console.error('DETAIL ERROR UPDATE PROMO:', err);
    errorMessage = `Gagal memperbarui promo: ${err.message || 'Terjadi kesalahan pada database.'}`;
  }
}

// Format tanggal untuk input type="date" (YYYY-MM-DD)
const formatDateForInput = (dateString) => {
  if (!dateString) return '';
  const date = new Date(dateString);
  return date.toISOString().split('T')[0];
};
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Promo - Admin Panel | Samudera Jaya Group</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --primary: #b91c1c;
      --primary-hover: #991b1b;
      --primary-dark: #450a0a;
      --bg-page: #f8f9fa;
      --bg-sidebar: #1a0404;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --border-color: #e5e7eb;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      line-height: 1.5;
    }

    /* ================= SIDEBAR ================= */
    .sidebar {
      width: 260px;
      background: linear-gradient(180deg, #2b0606 0%, #140808 100%);
      color: var(--white);
      height: 100vh;
      padding: 28px 20px;
      position: fixed;
      top: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      z-index: 100;
    }

    .sidebar-brand {
      padding-bottom: 22px;
      margin-bottom: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .brand-title {
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-decoration: none;
    }

    .brand-title .brand-main {
      font-size: 18px;
      font-weight: 800;
      color: #ef4444;
      letter-spacing: 0.5px;
    }

    .brand-title .brand-sub {
      font-size: 13px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 1.8px;
    }

    .sidebar h2 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: rgba(255, 255, 255, 0.45);
      margin-top: 12px;
      font-weight: 700;
    }

    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .sidebar a {
      color: rgba(255, 255, 255, 0.75);
      text-decoration: none;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.08);
      color: var(--white);
    }

    .sidebar a.active {
      background-color: var(--primary);
      color: var(--white);
      box-shadow: 0 4px 12px rgba(185, 28, 28, 0.35);
    }

    .sidebar .logout {
      margin-top: auto;
      color: #fca5a5;
      background-color: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
      justify-content: center;
    }

    .sidebar .logout:hover {
      background-color: #dc2626;
      color: var(--white);
      border-color: #dc2626;
    }

    /* ================= MAIN CONTENT ================= */
    .main-content {
      margin-left: 260px;
      flex: 1;
      padding: 40px 48px 64px;
      min-width: 0;
    }

    .page-top {
      max-width: 720px;
      margin-bottom: 28px;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 12px;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: color 0.2s ease, transform 0.2s ease;
    }

    .btn-back:hover {
      color: var(--primary);
      transform: translateX(-3px);
    }

    .page-top h1 {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.5px;
    }

    .page-subtitle {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* ================= FORM CARD ================= */
    .form-card {
      background: var(--white);
      padding: 36px 40px;
      border-radius: 18px;
      border: 1px solid var(--border-color);
      max-width: 720px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    }

    .error {
      color: #991b1b;
      margin-bottom: 24px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-left: 4px solid var(--primary);
      padding: 14px 16px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 500;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
      font-size: 13.5px;
      color: var(--text-main);
    }

    .form-group .sub-label {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
      margin-top: 12px;
    }

    .form-control {
      width: 100%;
      padding: 11px 14px;
      border: 1.5px solid var(--border-color);
      border-radius: 10px;
      font-family: inherit;
      font-size: 14px;
      color: var(--text-main);
      background-color: var(--white);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.12);
    }

    .form-control:disabled {
      background-color: #f3f4f6;
      color: var(--text-muted);
      cursor: not-allowed;
      font-weight: 600;
    }

    textarea.form-control {
      resize: vertical;
      line-height: 1.6;
    }

    input[type="file"].form-control {
      padding: 9px 12px;
      background-color: #f9fafb;
      cursor: pointer;
    }

    input[type="file"].form-control::file-selector-button {
      background-color: #fee2e2;
      color: var(--primary);
      border: none;
      padding: 6px 14px;
      border-radius: 6px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      margin-right: 12px;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    input[type="file"].form-control::file-selector-button:hover {
      background-color: #fecaca;
    }

    /* ================= IMAGE PREVIEW ================= */
    .preview-box {
      background-color: #f9fafb;
      border: 1px dashed #d1d5db;
      border-radius: 12px;
      padding: 16px;
    }

    .preview-img {
      width: 100%;
      max-width: 280px;
      height: 150px;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      display: block;
      background-color: var(--white);
    }

    /* ================= FORM ACTIONS ================= */
    .form-actions {
      display: flex;
      gap: 12px;
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid #f3f4f6;
    }

    .btn-submit {
      flex: 1;
      background: var(--primary);
      color: var(--white);
      border: none;
      padding: 13px 24px;
      border-radius: 10px;
      cursor: pointer;
      font-family: inherit;
      font-weight: 700;
      font-size: 15px;
      transition: background-color 0.2s ease, transform 0.15s ease;
    }

    .btn-submit:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
    }

    .btn-cancel {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 13px 22px;
      border-radius: 10px;
      border: 1.5px solid var(--border-color);
      color: var(--text-main);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .btn-cancel:hover {
      background-color: #f3f4f6;
      border-color: #d1d5db;
    }

    /* ================= RESPONSIVE ================= */
    @media (max-width: 900px) {
      body {
        flex-direction: column;
      }

      .sidebar {
        position: static;
        width: 100%;
        height: auto;
        padding: 20px;
      }

      .sidebar-nav {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .sidebar .logout {
        margin-top: 14px;
      }

      .main-content {
        margin-left: 0;
        padding: 28px 20px 48px;
      }

      .form-card {
        padding: 24px 20px;
      }

      .form-row {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .form-actions {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-brand">
      <a href="/admin/dashboard" class="brand-title">
        <span class="brand-main">SAMUDERA JAYA</span>
        <span class="brand-sub">GROUP</span>
      </a>
      <h2>Admin Panel</h2>
    </div>

    <nav class="sidebar-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/mobil">Kelola Mobil</a>
      <a href="/admin/promo" class="active">Kelola Promo</a>
    </nav>

    <a href="/admin/logout" class="logout">Logout</a>
  </aside>

  <main class="main-content">
    <div class="page-top">
      <a href="/admin/promo" class="btn-back">&larr; Kembali ke Kelola Promo</a>
      <h1>Edit Informasi Promo</h1>
      <p class="page-subtitle">Perbarui detail penawaran, periode berlaku, dan banner promo Samudera Jaya Group.</p>
    </div>
    
    <div class="form-card">
      {errorMessage && <div class="error">{errorMessage}</div>}
      <form method="POST" enctype="multipart/form-data">
        
        <div class="form-group">
          <label>ID Promo</label>
          <input type="text" class="form-control" value={promo.promo_id} disabled />
        </div>

        <div class="form-group">
          <label>Judul Promo</label>
          <input type="text" name="promo_judul" class="form-control" value={promo.promo_judul} required />
        </div>

        <div class="form-group">
          <label>Kategori Promo</label>
          <input type="text" name="promo_kategori" class="form-control" value={promo.promo_kategori} required />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Tanggal Mulai</label>
            <input type="date" name="promo_mulai" class="form-control" value={formatDateForInput(promo.promo_mulai)} required />
          </div>

          <div class="form-group">
            <label>Tanggal Berakhir</label>
            <input type="date" name="promo_berakhir" class="form-control" value={formatDateForInput(promo.promo_berakhir)} required />
          </div>
        </div>

        <div class="form-group">
          <label>Banner Promo</label>
          <div class="preview-box">
            {promo.promo_gambar && <img src={promo.promo_gambar} alt="Banner Promo" class="preview-img" />}
            <label class="sub-label">Ganti Banner (Opsional - Biarkan kosong jika tidak ingin mengubah)</label>
            <input type="file" name="promo_gambar" class="form-control" accept="image/*" />
          </div>
        </div>

        <div class="form-group">
          <label>Deskripsi & Syarat Ketentuan Promo</label>
          <textarea name="promo_deskripsi" class="form-control" rows="5">{promo.promo_deskripsi}</textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-submit">Perbarui Promo</button>
          <a href="/admin/promo" class="btn-cancel">Batal</a>
        </div>
      </form>
    </div>
  </main>

</body>
</html>