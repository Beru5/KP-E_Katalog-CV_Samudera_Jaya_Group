---
// @ts-nocheck
export const prerender = false;
import { pool } from '../../../lib/db.js';
import { catatLog } from '../../../lib/auditLog.js';
import fs from 'node:fs';
import path from 'node:path';

const sessionId = Astro.cookies.get('admin_session')?.value;
if (!sessionId) return Astro.redirect('/admin/login');

const [sessionRows] = await pool.query(`
  SELECT s.*, a.admin_id, a.username FROM Session s 
  JOIN Admin a ON s.admin_id = a.admin_id 
  WHERE s.session_id = ? AND s.expiration_time > NOW()
`, [sessionId]);

if (sessionRows.length === 0) {
  Astro.cookies.delete('admin_session', { path: '/' });
  return Astro.redirect('/admin/login');
}

const currentAdmin = sessionRows[0];
let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    
    let id_mobil;
    let isUnique = false;
    
    while (!isUnique) {
      id_mobil = Math.floor(100000 + Math.random() * 900000);
      const [existing] = await pool.query('SELECT id_mobil FROM Mobil WHERE id_mobil = ?', [id_mobil]);
      if (existing.length === 0) {
        isUnique = true;
      }
    }

    let brand_mobil = formData.get('brand_mobil')?.toString().trim();
    const brand_lainnya = formData.get('brand_lainnya')?.toString().trim();
    if (brand_mobil === 'Lainnya' && brand_lainnya) {
      brand_mobil = brand_lainnya;
    }

    const model_mobil = formData.get('model_mobil')?.toString().trim();
    
    const rawHarga = formData.get('harga')?.toString().replace(/\./g, '') || '0';
    const harga = Number(rawHarga) || 0;

    const tahun_mobil = Number(formData.get('tahun_mobil')) || new Date().getFullYear();
    const kapasitas_mesin = Number(formData.get('kapasitas_mesin')) || 0;

    const digit_tampil = Number(formData.get('digit_tampil')) || 3;
    const kategori_mobil = formData.get('kategori_mobil')?.toString().trim();
    const transmisi = formData.get('transmisi')?.toString().trim();
    const warna_mobil = formData.get('warna_mobil')?.toString().trim();
    const status_pajak = formData.get('status_pajak')?.toString().trim();
    
    const rawKm = formData.get('jumlah_km')?.toString().replace(/\./g, '') || '0';
    const jumlah_km = Number(rawKm) || 0;

    const deskripsi_mobil = formData.get('deskripsi_mobil')?.toString().trim();

    if (isNaN(harga) || isNaN(jumlah_km) || isNaN(tahun_mobil) || isNaN(kapasitas_mesin)) {
      throw new Error("Harga, Jumlah KM, Tahun, dan Kapasitas Mesin harus berupa angka yang valid.");
    }

    const imageFiles = formData.getAll('gambar_mobil');
    const savedFileNames = [];
    const uploadDir = path.resolve('./public/uploads');

    if (!fs.existsSync(uploadDir)) {
      fs.mkdirSync(uploadDir, { recursive: true });
    }

    for (const file of imageFiles) {
      if (file && typeof file === 'object' && file.size > 0) {
        const buffer = Buffer.from(await file.arrayBuffer());
        const fileName = `${Date.now()}-${file.name.replace(/\s+/g, '_')}`;
        fs.writeFileSync(path.join(uploadDir, fileName), buffer);
        savedFileNames.push(`/uploads/${fileName}`);
      }
    }

    if (savedFileNames.length === 0) {
      throw new Error("Minimal unggah 1 foto mobil.");
    }

    const gambar_mobil_json = JSON.stringify(savedFileNames);

    const conn = await pool.getConnection();
    try {
      await conn.beginTransaction();

      await conn.query(`
        INSERT INTO Mobil (id_mobil, brand_mobil, model_mobil, harga, tahun_mobil, kapasitas_mesin, kategori_mobil, transmisi, warna_mobil, status_pajak, jumlah_km, deskripsi_mobil, gambar_mobil, digit_tampil)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `, [id_mobil, brand_mobil, model_mobil, harga, tahun_mobil, kapasitas_mesin, kategori_mobil, transmisi, warna_mobil, status_pajak, jumlah_km, deskripsi_mobil, gambar_mobil_json, digit_tampil]);

      await catatLog({
        conn,
        admin_id: currentAdmin.admin_id,
        username: currentAdmin.username,
        aksi: 'CREATE_MOBIL',
        entitas: 'Mobil',
        target_id: id_mobil,
        ringkasan: `Menambahkan mobil baru #${id_mobil}: ${brand_mobil} ${model_mobil} (Rp ${harga.toLocaleString('id-ID')})`,
        data_sesudah: {
          id_mobil,
          brand_mobil,
          model_mobil,
          harga,
          tahun_mobil,
          kapasitas_mesin,
          digit_tampil,
          kategori_mobil,
          transmisi,
          warna_mobil,
          status_pajak,
          jumlah_km,
          deskripsi_mobil,
          gambar_mobil: savedFileNames
        },
        ip_address: Astro.clientAddress
      });

      await conn.commit();
    } catch (txErr) {
      await conn.rollback();
      throw txErr;
    } finally {
      conn.release();
    }

    return Astro.redirect('/admin/mobil');
  } catch (err) {
    console.error('DETAIL ERROR DATABASE:', err);
    errorMessage = `Gagal menyimpan data: ${err.message || 'Terjadi kesalahan pada database.'}`;
  }
}
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tambah Mobil - Admin Panel | Samudera Jaya Group</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --primary: #b91c1c;
      --primary-hover: #991b1b;
      --primary-dark: #450a0a;
      --bg-page: #f8f9fa;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --border-color: #e5e7eb;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      line-height: 1.5;
    }

    /* ================= SIDEBAR ================= */
    .sidebar {
      width: 260px;
      background: linear-gradient(180deg, #2b0606 0%, #140808 100%);
      color: var(--white);
      height: 100vh;
      padding: 28px 20px;
      position: fixed;
      top: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      z-index: 100;
    }

    .sidebar-brand {
      padding-bottom: 22px;
      margin-bottom: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .brand-title {
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-decoration: none;
    }

    .brand-title .brand-main {
      font-size: 18px;
      font-weight: 800;
      color: #ef4444;
      letter-spacing: 0.5px;
    }

    .brand-title .brand-sub {
      font-size: 13px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 1.8px;
    }

    .sidebar h2 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: rgba(255, 255, 255, 0.45);
      margin-top: 12px;
      font-weight: 700;
    }

    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .sidebar a {
      color: rgba(255, 255, 255, 0.75);
      text-decoration: none;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.08);
      color: var(--white);
    }

    .sidebar a.active {
      background-color: var(--primary);
      color: var(--white);
      box-shadow: 0 4px 12px rgba(185, 28, 28, 0.35);
    }

    .sidebar .logout {
      margin-top: auto;
      color: #fca5a5;
      background-color: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
      justify-content: center;
    }

    .sidebar .logout:hover {
      background-color: #dc2626;
      color: var(--white);
      border-color: #dc2626;
    }

    /* ================= MAIN CONTENT ================= */
    .main-content {
      margin-left: 260px;
      flex: 1;
      padding: 40px 48px 64px;
      min-width: 0;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      flex-wrap: wrap;
      padding-bottom: 24px;
      margin-bottom: 28px;
      border-bottom: 1px solid var(--border-color);
    }

    .page-header h1 {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.5px;
    }

    .page-subtitle {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 18px;
      border-radius: 10px;
      background: var(--white);
      border: 1.5px solid var(--border-color);
      color: var(--text-main);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .btn-back:hover {
      background: #f3f4f6;
      border-color: #d1d5db;
    }

    /* ================= FORM CARD ================= */
    .form-card {
      background: var(--white);
      padding: 36px;
      border-radius: 18px;
      border: 1px solid var(--border-color);
      max-width: 820px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    }

    .error {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
      border-left: 4px solid #dc2626;
      padding: 14px 18px;
      border-radius: 12px;
      margin-bottom: 24px;
      font-size: 14px;
      font-weight: 600;
    }

    .form-section-title {
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--primary);
      padding-bottom: 10px;
      margin-bottom: 18px;
      border-bottom: 1px solid #f3f4f6;
    }

    .form-section-title.spaced {
      margin-top: 28px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    .form-group label {
      font-size: 13.5px;
      font-weight: 700;
      color: #374151;
    }

    .form-hint {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .form-control {
      width: 100%;
      padding: 11px 14px;
      border: 1.5px solid var(--border-color);
      border-radius: 10px;
      font-family: inherit;
      font-size: 14px;
      color: var(--text-main);
      background-color: var(--white);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.12);
    }

    textarea.form-control {
      resize: vertical;
      min-height: 110px;
      line-height: 1.6;
    }

    input[type="file"].form-control {
      padding: 10px 12px;
      background-color: #f9fafb;
      border-style: dashed;
      cursor: pointer;
    }

    input[type="file"].form-control::file-selector-button {
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      color: var(--white);
      background: #374151;
      border: none;
      padding: 7px 14px;
      border-radius: 8px;
      margin-right: 12px;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    input[type="file"].form-control::file-selector-button:hover {
      background: #1f2937;
    }

    .hidden {
      display: none !important;
    }

    .form-actions {
      margin-top: 30px;
      padding-top: 22px;
      border-top: 1px solid #f3f4f6;
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn-cancel {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 22px;
      border-radius: 10px;
      background: var(--white);
      border: 1.5px solid var(--border-color);
      color: #4b5563;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      transition: all 0.2s ease;
    }

    .btn-cancel:hover {
      background: #f3f4f6;
      color: var(--text-main);
    }

    .btn-submit {
      background: var(--primary);
      color: var(--white);
      border: none;
      padding: 12px 28px;
      border-radius: 10px;
      cursor: pointer;
      font-family: inherit;
      font-weight: 700;
      font-size: 14.5px;
      transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 12px rgba(185, 28, 28, 0.25);
    }

    .btn-submit:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(185, 28, 28, 0.32);
    }

    .btn-submit:active {
      transform: translateY(0);
    }

    /* ================= RESPONSIVE ================= */
    @media (max-width: 900px) {
      body {
        flex-direction: column;
      }

      .sidebar {
        position: static;
        width: 100%;
        height: auto;
        padding: 20px;
      }

      .sidebar-nav {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .sidebar .logout {
        margin-top: 14px;
      }

      .main-content {
        margin-left: 0;
        padding: 28px 20px 48px;
      }

      .page-header h1 {
        font-size: 24px;
      }

      .form-card {
        padding: 24px 20px;
      }
    }

    @media (max-width: 640px) {
      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-actions {
        flex-direction: column-reverse;
      }

      .btn-cancel,
      .btn-submit {
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-brand">
      <a href="/admin/dashboard" class="brand-title">
        <span class="brand-main">SAMUDERA JAYA</span>
        <span class="brand-sub">GROUP</span>
      </a>
      <h2>Admin Panel</h2>
    </div>

    <nav class="sidebar-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/mobil" class="active">Kelola Mobil</a>
      <a href="/admin/mobil/arsip">Arsip Terjual</a>
      <a href="/admin/promo">Kelola Promo</a>
      <a href="/admin/log">Audit Log</a>
    </nav>

    <a href="/admin/logout" class="logout">Logout</a>
  </aside>

  <main class="main-content">
    <div class="page-header">
      <div>
        <h1>Tambah Info Mobil Baru</h1>
        <p class="page-subtitle">Lengkapi spesifikasi, harga, dan foto unit untuk ditampilkan ke katalog.</p>
      </div>
      <a href="/admin/mobil" class="btn-back">&larr; Kembali ke Kelola Mobil</a>
    </div>

    <div class="form-card">
      {errorMessage && <div class="error" role="alert">{errorMessage}</div>}

      <form method="POST" enctype="multipart/form-data">
        <div class="form-section-title">Informasi Utama</div>
        <div class="form-grid">
          <div class="form-group">
            <label for="brandSelect">Brand Mobil</label>
            <select id="brandSelect" name="brand_mobil" class="form-control" required>
              <option value="">Pilih Brand</option>
              <option value="Toyota">Toyota</option>
              <option value="Honda">Honda</option>
              <option value="Suzuki">Suzuki</option>
              <option value="Daihatsu">Daihatsu</option>
              <option value="Mitsubishi">Mitsubishi</option>
              <option value="Hyundai">Hyundai</option>
              <option value="Wuling">Wuling</option>
              <option value="Lainnya">Lainnya..</option>
            </select>
          </div>

          <div class="form-group">
            <label for="modelInput">Model Mobil</label>
            <input type="text" id="modelInput" name="model_mobil" class="form-control" placeholder="Contoh: Avanza 1.5 G CVT" required />
          </div>

          <div class="form-group full-width hidden" id="brandLainnyaGroup">
            <label for="brandLainnyaInput">Masukkan Brand Lainnya</label>
            <input type="text" id="brandLainnyaInput" name="brand_lainnya" class="form-control" placeholder="Nama brand baru..." />
          </div>

          <div class="form-group">
            <label for="kategoriInput">Kategori Mobil</label>
            <select id="kategoriInput" name="kategori_mobil" class="form-control" required>
              <option value="">Pilih Kategori</option>
              <option value="SUV">SUV</option>
              <option value="MPV">MPV</option>
              <option value="Sedan">Sedan</option>
              <option value="Hatchback">Hatchback</option>
              <option value="City Car">City Car</option>
            </select>
          </div>

          <div class="form-group">
            <label for="tahunInput">Tahun Mobil</label>
            <input type="number" id="tahunInput" name="tahun_mobil" class="form-control" value="2023" min="1990" max="2030" required />
          </div>
        </div>

        <div class="form-section-title spaced">Harga &amp; Spesifikasi</div>
        <div class="form-grid">
          <div class="form-group">
            <label for="hargaInput">Harga (Rp)</label>
            <input type="text" id="hargaInput" name="harga" class="form-control" placeholder="Contoh: 250.000.000" required />
          </div>

          <div class="form-group">
            <label for="digitTampilInput">Digit Depan Harga yang Ditampilkan</label>
            <input type="number" id="digitTampilInput" name="digit_tampil" class="form-control" value="3" min="1" max="15" required />
          </div>

          <div class="form-group">
            <label for="kapasitasMesinInput">Kapasitas Mesin / CC (Integer)</label>
            <input type="number" id="kapasitasMesinInput" name="kapasitas_mesin" class="form-control" value="1500" min="500" max="10000" step="1" required />
          </div>

          <div class="form-group">
            <label for="transmisiInput">Transmisi</label>
            <select id="transmisiInput" name="transmisi" class="form-control">
              <option value="Automatic">Automatic</option>
              <option value="Manual">Manual</option>
            </select>
          </div>

          <div class="form-group">
            <label for="warnaInput">Warna Mobil</label>
            <input type="text" id="warnaInput" name="warna_mobil" class="form-control" placeholder="Contoh: Hitam Metalik" />
          </div>

          <div class="form-group">
            <label for="statusPajakInput">Status Pajak</label>
            <select id="statusPajakInput" name="status_pajak" class="form-control" required>
              <option value="Hidup">Hidup</option>
              <option value="Mati">Mati</option>
            </select>
          </div>

          <div class="form-group full-width">
            <label for="kmInput">Jumlah KM</label>
            <input type="text" id="kmInput" name="jumlah_km" class="form-control" placeholder="Contoh: 45.000" />
          </div>
        </div>

        <div class="form-section-title spaced">Media &amp; Deskripsi</div>
        <div class="form-grid">
          <div class="form-group full-width">
            <label for="gambarInput">Foto Mobil (Bisa pilih banyak sekaligus)</label>
            <input type="file" id="gambarInput" name="gambar_mobil" class="form-control" multiple accept="image/*" required />
            <span class="form-hint">Minimal unggah 1 foto mobil berformat gambar (JPG, PNG, WebP).</span>
          </div>

          <div class="form-group full-width">
            <label for="deskripsiInput">Deskripsi Mobil</label>
            <textarea id="deskripsiInput" name="deskripsi_mobil" class="form-control" rows="4" placeholder="Tuliskan kondisi unit, riwayat servis, kelengkapan surat, atau catatan tambahan..."></textarea>
          </div>
        </div>

        <div class="form-actions">
          <a href="/admin/mobil" class="btn-cancel">Batal</a>
          <button type="submit" class="btn-submit">Simpan Mobil Baru</button>
        </div>
      </form>
    </div>
  </main>

  <script>
    const brandSelect = document.getElementById('brandSelect') as HTMLSelectElement;
    const brandLainnyaGroup = document.getElementById('brandLainnyaGroup') as HTMLElement;
    const brandLainnyaInput = document.getElementById('brandLainnyaInput') as HTMLInputElement;

    function toggleBrandLainnya() {
      if (brandSelect.value === 'Lainnya') {
        brandLainnyaGroup.classList.remove('hidden');
        brandLainnyaInput.required = true;
      } else {
        brandLainnyaGroup.classList.add('hidden');
        brandLainnyaInput.required = false;
        brandLainnyaInput.value = '';
      }
    }

    toggleBrandLainnya();
    brandSelect.addEventListener('change', toggleBrandLainnya);

    function formatNumberInput(inputElement: HTMLInputElement) {
      inputElement.addEventListener('input', () => {
        let rawValue = inputElement.value.replace(/\D/g, '');
        if (rawValue) {
          inputElement.value = Number(rawValue).toLocaleString('id-ID');
        } else {
          inputElement.value = '';
        }
      });
    }

    const hargaInput = document.getElementById('hargaInput') as HTMLInputElement;
    const kmInput = document.getElementById('kmInput') as HTMLInputElement;

    if (hargaInput) formatNumberInput(hargaInput);
    if (kmInput) formatNumberInput(kmInput);
  </script>
</body>
</html>