---
// @ts-nocheck
export const prerender = false;
import { pool } from '../../../lib/db.js';
import { catatLog } from '../../../lib/auditLog.js';
import fs from 'node:fs';
import path from 'node:path';

const sessionId = Astro.cookies.get('admin_session')?.value;
if (!sessionId) return Astro.redirect('/admin/login');

const [sessionRows] = await pool.query(`
  SELECT s.*, a.admin_id, a.username FROM Session s 
  JOIN Admin a ON s.admin_id = a.admin_id 
  WHERE s.session_id = ? AND s.expiration_time > NOW()
`, [sessionId]);

if (sessionRows.length === 0) {
  Astro.cookies.delete('admin_session', { path: '/' });
  return Astro.redirect('/admin/login');
}

const currentAdmin = sessionRows[0];
let errorMessage = '';
let successMessage = '';

function removeLocalFiles(imageField) {
  const uploadRoot = path.resolve('./public');
  let list = [];
  try {
    list = JSON.parse(imageField || '[]');
  } catch {
    list = imageField ? [imageField] : [];
  }

  for (const relPath of list) {
    if (typeof relPath === 'string' && relPath.startsWith('/uploads/')) {
      const fullPath = path.join(uploadRoot, relPath);
      if (fs.existsSync(fullPath)) {
        fs.unlinkSync(fullPath);
      }
    }
  }
}

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();
    const id_mobil = formData.get('id_mobil')?.toString();

    if (!id_mobil) {
      throw new Error('ID mobil tidak ditemukan.');
    }

    const [mobilRows] = await pool.query('SELECT * FROM Mobil WHERE id_mobil = ?', [id_mobil]);
    if (mobilRows.length === 0) {
      throw new Error('Data mobil tidak ditemukan di database.');
    }
    const mobil = mobilRows[0];

    if (action === 'delete_permanent') {
      const conn = await pool.getConnection();
      try {
        await conn.beginTransaction();

        await conn.query('DELETE FROM Mobil WHERE id_mobil = ?', [id_mobil]);

        await catatLog({
          conn,
          admin_id: currentAdmin.admin_id,
          username: currentAdmin.username,
          aksi: 'DELETE_MOBIL_PERMANENT',
          entitas: 'Mobil',
          target_id: id_mobil,
          ringkasan: `Hapus permanen (salah input) mobil #${id_mobil}: ${mobil.brand_mobil} ${mobil.model_mobil}`,
          data_sebelum: mobil,
          ip_address: Astro.clientAddress
        });

        await conn.commit();
      } catch (txErr) {
        await conn.rollback();
        throw txErr;
      } finally {
        conn.release();
      }

      removeLocalFiles(mobil.gambar_mobil);
      return Astro.redirect('/admin/mobil?status=deleted');
    }

    if (action === 'delete_sold') {
      const buktiFile = formData.get('bukti_penjualan');
      if (!buktiFile || typeof buktiFile !== 'object' || buktiFile.size === 0) {
        throw new Error('Bukti penjualan berupa file gambar wajib diunggah untuk mobil terjual.');
      }

      if (buktiFile.type && !buktiFile.type.startsWith('image/')) {
        throw new Error('File bukti penjualan harus berupa gambar (JPG, PNG, WEBP, dll).');
      }

      const uploadDir = path.resolve('./public/uploads/bukti');
      if (!fs.existsSync(uploadDir)) {
        fs.mkdirSync(uploadDir, { recursive: true });
      }

      const safeName = buktiFile.name.replace(/\s+/g, '_').replace(/[^a-zA-Z0-9._-]/g, '');
      const fileName = `bukti-${Date.now()}-${safeName}`;
      const buffer = Buffer.from(await buktiFile.arrayBuffer());
      fs.writeFileSync(path.join(uploadDir, fileName), buffer);
      const buktiUrl = `/uploads/bukti/${fileName}`;

      const conn = await pool.getConnection();
      try {
        await conn.beginTransaction();

        await conn.query(`
          INSERT INTO Mobil_Terjual (
            id_mobil, brand_mobil, model_mobil, harga, kategori_mobil, transmisi,
            warna_mobil, status_pajak, jumlah_km, tahun_mobil, kapasitas_mesin,
            deskripsi_mobil, gambar_mobil, bukti_penjualan
          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        `, [
          mobil.id_mobil,
          mobil.brand_mobil,
          mobil.model_mobil,
          mobil.harga || 0,
          mobil.kategori_mobil,
          mobil.transmisi,
          mobil.warna_mobil,
          mobil.status_pajak,
          mobil.jumlah_km || 0,
          mobil.tahun_mobil || null,
          mobil.kapasitas_mesin || 0,
          mobil.deskripsi_mobil,
          mobil.gambar_mobil,
          buktiUrl
        ]);

        await conn.query('DELETE FROM Mobil WHERE id_mobil = ?', [id_mobil]);

        await catatLog({
          conn,
          admin_id: currentAdmin.admin_id,
          username: currentAdmin.username,
          aksi: 'MARK_MOBIL_SOLD',
          entitas: 'Mobil',
          target_id: id_mobil,
          ringkasan: `Menandai terjual & mengarsipkan mobil #${id_mobil}: ${mobil.brand_mobil} ${mobil.model_mobil}`,
          data_sebelum: mobil,
          data_sesudah: { status: 'Terjual', bukti_penjualan: buktiUrl },
          ip_address: Astro.clientAddress
        });

        await conn.commit();
      } catch (txErr) {
        await conn.rollback();
        throw txErr;
      } finally {
        conn.release();
      }

      return Astro.redirect('/admin/mobil/arsip?status=sold');
    }
  } catch (err) {
    console.error('ERROR AKSI MOBIL:', err);
    errorMessage = err.message || 'Terjadi kesalahan saat memproses data.';
  }
}

const statusParam = Astro.url.searchParams.get('status');
if (statusParam === 'deleted') {
  successMessage = 'Data mobil berhasil dihapus secara permanen.';
}

const [mobilRows] = await pool.query('SELECT * FROM Mobil ORDER BY id_mobil DESC');
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <title>Kelola Mobil - Admin Panel</title>
  <style>
    body { font-family: sans-serif; margin: 0; background: #f9f9f9; display: flex; }
    .sidebar { width: 250px; background: #333; color: white; height: 100vh; padding: 20px; box-sizing: border-box; position: fixed; display: flex; flex-direction: column; }
    .sidebar h2 { font-size: 18px; margin-bottom: 30px; }
    .sidebar a { color: #ddd; text-decoration: none; padding: 10px 0; display: block; font-size: 15px; }
    .sidebar a:hover, .sidebar a.active { color: white; font-weight: bold; }
    .sidebar .logout { margin-top: auto; color: #ff4757; font-weight: bold; display: block; }

    .main-content { margin-left: 250px; flex: 1; padding: 40px; box-sizing: border-box; }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ddd; padding-bottom: 20px; margin-bottom: 25px; gap: 12px; flex-wrap: wrap; }
    .header-actions { display: flex; gap: 10px; }
    .btn-add { background: #333; color: white; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 14px; }
    .btn-add:hover { background: #555; }
    .btn-archive { background: #0f766e; color: white; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 14px; }
    .btn-archive:hover { background: #115e59; }

    .alert-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; }
    .alert-success { background: #dcfce7; color: #166534; border: 1px solid #86efac; padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; }

    table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }
    th { background: #f1f2f6; color: #333; }

    .btn-action { padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 13px; font-weight: bold; margin-right: 5px; display: inline-block; border: none; cursor: pointer; }
    .btn-edit { background: #333; color: white; }
    .btn-edit:hover { background: #555; }
    .btn-delete { background: #dc2626; color: white; }
    .btn-delete:hover { background: #b91c1c; }

    /* Modal */
    .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.55); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 16px; }
    .modal-backdrop.show { display: flex; }
    .modal-box { background: white; width: 100%; max-width: 480px; border-radius: 10px; padding: 24px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .modal-header h3 { margin: 0; font-size: 18px; color: #222; }
    .modal-close { background: none; border: none; font-size: 22px; cursor: pointer; color: #666; }

    .option-group { display: flex; flex-direction: column; gap: 10px; margin: 16px 0; }
    .option-card { border: 1px solid #d1d5db; border-radius: 8px; padding: 12px; cursor: pointer; display: flex; gap: 10px; align-items: flex-start; }
    .option-card input { margin-top: 3px; }
    .option-title { font-weight: bold; font-size: 14px; color: #111827; display: block; }
    .option-desc { font-size: 12px; color: #6b7280; }

    .sold-box { display: none; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 14px; margin-bottom: 16px; }
    .sold-box.show { display: block; }
    .sold-box label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 6px; color: #1e293b; }
    .form-control { width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; box-sizing: border-box; background: white; }

    .modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px; }
    .btn-cancel { background: #e5e7eb; color: #374151; border: none; padding: 10px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; }
    .btn-confirm-perm { background: #dc2626; color: white; border: none; padding: 10px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; }
    .btn-confirm-sold { background: #0f766e; color: white; border: none; padding: 10px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; }
  </style>
</head>
<body>

  <div class="sidebar">
    <h2>Admin Panel</h2>
    <a href="/admin/dashboard">Dashboard</a>
    <a href="/admin/mobil" class="active">Kelola Mobil</a>
    <a href="/admin/mobil/arsip">Arsip Terjual</a>
    <a href="/admin/promo">Kelola Promo</a>
    <a href="/admin/log">Audit Log</a>
    <a href="/admin/logout" class="logout">Logout</a>
  </div>

  <div class="main-content">
    <div class="header">
      <h1>Kelola Informasi Mobil</h1>
      <div class="header-actions">
        <a href="/admin/mobil/arsip" class="btn-archive">Lihat Arsip Terjual</a>
        <a href="/admin/mobil/create" class="btn-add">+ Tambah Mobil Baru</a>
      </div>
    </div>

    {errorMessage && <div class="alert-error">{errorMessage}</div>}
    {successMessage && <div class="alert-success">{successMessage}</div>}

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Brand & Model</th>
          <th>Kategori</th>
          <th>Harga</th>
          <th>Transmisi</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        {mobilRows.map((mobil) => (
          <tr>
            <td>{mobil.id_mobil}</td>
            <td><strong>{mobil.brand_mobil}</strong> {mobil.model_mobil}</td>
            <td>{mobil.kategori_mobil}</td>
            <td>Rp {Number(mobil.harga).toLocaleString('id-ID')}</td>
            <td>{mobil.transmisi}</td>
            <td>
              <a href={`/admin/mobil/${mobil.id_mobil}`} class="btn-action btn-edit">Edit</a>
              <button
                type="button"
                class="btn-action btn-delete"
                onclick={`openDeleteModal('${mobil.id_mobil}', '${String(mobil.brand_mobil + ' ' + mobil.model_mobil).replace(/'/g, "\\'")}')`}
              >
                Delete
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Modal Pilihan Delete -->
  <div id="deleteModal" class="modal-backdrop">
    <div class="modal-box">
      <div class="modal-header">
        <h3>Hapus Data Mobil</h3>
        <button type="button" class="modal-close" onclick="closeDeleteModal()">&times;</button>
      </div>
      <p style="margin: 0; font-size: 14px; color: #4b5563;">
        Pilih alasan penghapusan untuk <strong id="modalMobilLabel"></strong>:
      </p>

      <form method="POST" enctype="multipart/form-data" id="deleteForm">
        <input type="hidden" name="id_mobil" id="modalIdMobil" />

        <div class="option-group">
          <label class="option-card">
            <input type="radio" name="delete_mode" value="permanent" checked onchange="toggleDeleteMode()" />
            <span>
              <span class="option-title">Salah Input / Hapus Permanen</span>
              <span class="option-desc">Menghapus data secara permanen dari sistem (tidak masuk ke arsip terjual).</span>
            </span>
          </label>

          <label class="option-card">
            <input type="radio" name="delete_mode" value="sold" onchange="toggleDeleteMode()" />
            <span>
              <span class="option-title">Mobil Terjual (Pindahkan ke Arsip)</span>
              <span class="option-desc">Memindahkan data ke halaman arsip terjual dan wajib menyertakan bukti gambar.</span>
            </span>
          </label>
        </div>

        <div id="soldProofBox" class="sold-box">
          <label for="buktiInput">Bukti Penjualan (File Gambar Wajib)</label>
          <input type="file" id="buktiInput" name="bukti_penjualan" class="form-control" accept="image/*" />
          <small style="color:#64748b; display:block; margin-top:6px;">Contoh: foto kwitansi, nota serah terima, atau bukti transfer.</small>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Batal</button>
          <button type="submit" id="confirmBtn" class="btn-confirm-perm">Hapus Permanen</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById('deleteModal') as HTMLElement | null;
    const modalIdMobil = document.getElementById('modalIdMobil') as HTMLInputElement | null;
    const modalMobilLabel = document.getElementById('modalMobilLabel') as HTMLElement | null;
    const soldProofBox = document.getElementById('soldProofBox') as HTMLElement | null;
    const buktiInput = document.getElementById('buktiInput') as HTMLInputElement | null;
    const confirmBtn = document.getElementById('confirmBtn') as HTMLButtonElement | null;
    const deleteForm = document.getElementById('deleteForm') as HTMLFormElement | null;

    function openDeleteModal(id: string, label: string) {
      if (!modal || !modalIdMobil || !modalMobilLabel || !deleteForm || !buktiInput) return;

      modalIdMobil.value = id;
      modalMobilLabel.textContent = label;

      const permRadio = deleteForm.querySelector('input[value="permanent"]') as HTMLInputElement | null;
      if (permRadio) {
        permRadio.checked = true;
      }

      buktiInput.value = '';
      toggleDeleteMode();
      modal.classList.add('show');
    }

    function closeDeleteModal() {
      if (!modal) return;
      modal.classList.remove('show');
    }

    function toggleDeleteMode() {
      if (!deleteForm || !soldProofBox || !buktiInput || !confirmBtn) return;

      const selectedRadio = deleteForm.querySelector('input[name="delete_mode"]:checked') as HTMLInputElement | null;
      const selected = selectedRadio ? selectedRadio.value : 'permanent';

      if (selected === 'sold') {
        soldProofBox.classList.add('show');
        buktiInput.required = true;
        confirmBtn.textContent = 'Simpan ke Arsip Terjual';
        confirmBtn.className = 'btn-confirm-sold';
      } else {
        soldProofBox.classList.remove('show');
        buktiInput.required = false;
        confirmBtn.textContent = 'Hapus Permanen';
        confirmBtn.className = 'btn-confirm-perm';
      }
    }

    if (deleteForm) {
      deleteForm.addEventListener('submit', (e) => {
        const selectedRadio = deleteForm.querySelector('input[name="delete_mode"]:checked') as HTMLInputElement | null;
        const selected = selectedRadio ? selectedRadio.value : 'permanent';

        let hiddenAction = deleteForm.querySelector('input[name="action"]') as HTMLInputElement | null;
        if (!hiddenAction) {
          hiddenAction = document.createElement('input');
          hiddenAction.type = 'hidden';
          hiddenAction.name = 'action';
          deleteForm.appendChild(hiddenAction);
        }
        hiddenAction.value = selected === 'sold' ? 'delete_sold' : 'delete_permanent';

        if (selected === 'sold') {
          if (!buktiInput || !buktiInput.files || buktiInput.files.length === 0) {
            e.preventDefault();
            alert('Silakan pilih file gambar bukti penjualan terlebih dahulu.');
            return;
          }
          if (!confirm('Tandai mobil ini sebagai TERJUAL dan pindahkan ke halaman arsip?')) {
            e.preventDefault();
          }
        } else {
          if (!confirm('Yakin ingin menghapus data ini secara permanen karena salah input?')) {
            e.preventDefault();
          }
        }
      });
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeDeleteModal();
      });
    }

    (window as unknown as {
      openDeleteModal: (id: string, label: string) => void;
      closeDeleteModal: () => void;
      toggleDeleteMode: () => void;
    }).openDeleteModal = openDeleteModal;

    (window as unknown as { closeDeleteModal: () => void }).closeDeleteModal = closeDeleteModal;
    (window as unknown as { toggleDeleteMode: () => void }).toggleDeleteMode = toggleDeleteMode;
  </script>
</body>
</html>