---
// @ts-nocheck
export const prerender = false;
import { pool } from '../../../lib/db.js';

const sessionId = Astro.cookies.get('admin_session')?.value;
if (!sessionId) return Astro.redirect('/admin/login');

const [sessionRows] = await pool.query(`
  SELECT * FROM Session s JOIN Admin a ON s.admin_id = a.admin_id 
  WHERE s.session_id = ? AND s.expiration_time > NOW()
`, [sessionId]);

if (sessionRows.length === 0) {
  Astro.cookies.delete('admin_session', { path: '/' });
  return Astro.redirect('/admin/login');
}

const statusParam = Astro.url.searchParams.get('status');
const successMessage = statusParam === 'sold'
  ? 'Mobil berhasil ditandai terjual dan dipindahkan ke arsip.'
  : '';

const [arsipRows] = await pool.query('SELECT * FROM Mobil_Terjual ORDER BY tanggal_terjual DESC, id_arsip DESC');
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <title>Arsip Mobil Terjual - Admin Panel</title>
  <style>
    body { font-family: sans-serif; margin: 0; background: #f9f9f9; display: flex; }
    .sidebar { width: 250px; background: #333; color: white; height: 100vh; padding: 20px; box-sizing: border-box; position: fixed; display: flex; flex-direction: column; }
    .sidebar h2 { font-size: 18px; margin-bottom: 30px; }
    .sidebar a { color: #ddd; text-decoration: none; padding: 10px 0; display: block; font-size: 15px; }
    .sidebar a:hover, .sidebar a.active { color: white; font-weight: bold; }
    .sidebar .logout { margin-top: auto; color: #ff4757; font-weight: bold; display: block; }

    .main-content { margin-left: 250px; flex: 1; padding: 40px; box-sizing: border-box; }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ddd; padding-bottom: 20px; margin-bottom: 25px; gap: 12px; flex-wrap: wrap; }
    .btn-back { background: #333; color: white; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 14px; }
    .btn-back:hover { background: #555; }

    .alert-success { background: #dcfce7; color: #166534; border: 1px solid #86efac; padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; }

    table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; vertical-align: middle; }
    th { background: #f1f2f6; color: #333; }

    .badge-sold { background: #ccfbf1; color: #0f766e; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: bold; }
    .bukti-thumb { width: 84px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd; display: block; }
    .empty-state { background: white; padding: 30px; text-align: center; border-radius: 8px; color: #666; border: 1px solid #eee; }
  </style>
</head>
<body>

  <div class="sidebar">
    <h2>Admin Panel</h2>
    <a href="/admin/dashboard">Dashboard</a>
    <a href="/admin/mobil">Kelola Mobil</a>
    <a href="/admin/mobil/arsip" class="active">Arsip Terjual</a>
    <a href="/admin/promo">Kelola Promo</a>
    <a href="/admin/logout" class="logout">Logout</a>
  </div>

  <div class="main-content">
    <div class="header">
      <h1>Arsip Mobil Terjual</h1>
      <a href="/admin/mobil" class="btn-back">&larr; Kembali ke Kelola Mobil</a>
    </div>

    {successMessage && <div class="alert-success">{successMessage}</div>}

    {arsipRows.length === 0 ? (
      <div class="empty-state">Belum ada data mobil terjual di arsip.</div>
    ) : (
      <table>
        <thead>
          <tr>
            <th>ID Mobil</th>
            <th>Brand & Model</th>
            <th>Kategori</th>
            <th>Harga</th>
            <th>Bukti Penjualan</th>
            <th>Tanggal Terjual</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {arsipRows.map((item) => (
            <tr>
              <td>{item.id_mobil}</td>
              <td><strong>{item.brand_mobil}</strong> {item.model_mobil}</td>
              <td>{item.kategori_mobil}</td>
              <td>Rp {Number(item.harga).toLocaleString('id-ID')}</td>
              <td>
                <a href={item.bukti_penjualan} target="_blank" rel="noopener noreferrer" title="Lihat ukuran penuh">
                  <img src={item.bukti_penjualan} alt={`Bukti penjualan ${item.brand_mobil} ${item.model_mobil}`} class="bukti-thumb" />
                </a>
              </td>
              <td>{new Date(item.tanggal_terjual).toLocaleString('id-ID')}</td>
              <td><span class="badge-sold">Terjual</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

</body>
</html>