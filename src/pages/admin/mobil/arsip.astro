---
// @ts-nocheck
export const prerender = false;
import { pool } from '../../../lib/db.js';

const sessionId = Astro.cookies.get('admin_session')?.value;
if (!sessionId) return Astro.redirect('/admin/login');

const [sessionRows] = await pool.query(`
  SELECT * FROM Session s JOIN Admin a ON s.admin_id = a.admin_id 
  WHERE s.session_id = ? AND s.expiration_time > NOW()
`, [sessionId]);

if (sessionRows.length === 0) {
  Astro.cookies.delete('admin_session', { path: '/' });
  return Astro.redirect('/admin/login');
}

const statusParam = Astro.url.searchParams.get('status');
const successMessage = statusParam === 'sold'
  ? 'Mobil berhasil ditandai terjual dan dipindahkan ke arsip.'
  : '';

const [arsipRows] = await pool.query('SELECT * FROM Mobil_Terjual ORDER BY tanggal_terjual DESC, id_arsip DESC');
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Arsip Mobil Terjual - Admin Panel | Samudera Jaya Group</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --primary: #b91c1c;
      --primary-hover: #991b1b;
      --primary-dark: #450a0a;
      --bg-page: #f8f9fa;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --border-color: #e5e7eb;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      line-height: 1.5;
    }

    /* ================= SIDEBAR ================= */
    .sidebar {
      width: 260px;
      background: linear-gradient(180deg, #2b0606 0%, #140808 100%);
      color: var(--white);
      height: 100vh;
      padding: 28px 20px;
      position: fixed;
      top: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      z-index: 100;
    }

    .sidebar-brand {
      padding-bottom: 22px;
      margin-bottom: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .brand-title {
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-decoration: none;
    }

    .brand-title .brand-main {
      font-size: 18px;
      font-weight: 800;
      color: #ef4444;
      letter-spacing: 0.5px;
    }

    .brand-title .brand-sub {
      font-size: 13px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 1.8px;
    }

    .sidebar h2 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: rgba(255, 255, 255, 0.45);
      margin-top: 12px;
      font-weight: 700;
    }

    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .sidebar a {
      color: rgba(255, 255, 255, 0.75);
      text-decoration: none;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.08);
      color: var(--white);
    }

    .sidebar a.active {
      background-color: var(--primary);
      color: var(--white);
      box-shadow: 0 4px 12px rgba(185, 28, 28, 0.35);
    }

    .sidebar .logout {
      margin-top: auto;
      color: #fca5a5;
      background-color: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
      justify-content: center;
    }

    .sidebar .logout:hover {
      background-color: #dc2626;
      color: var(--white);
      border-color: #dc2626;
    }

    /* ================= MAIN CONTENT ================= */
    .main-content {
      margin-left: 260px;
      flex: 1;
      padding: 40px 48px 64px;
      min-width: 0;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      flex-wrap: wrap;
      padding-bottom: 24px;
      margin-bottom: 28px;
      border-bottom: 1px solid var(--border-color);
    }

    .page-header h1 {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.5px;
    }

    .page-subtitle {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 18px;
      border-radius: 10px;
      background: var(--white);
      border: 1.5px solid var(--border-color);
      color: var(--text-main);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .btn-back:hover {
      background: #f3f4f6;
      border-color: #d1d5db;
    }

    /* ================= ALERT ================= */
    .alert-success {
      background: #f0fdf4;
      color: #166534;
      border: 1px solid #bbf7d0;
      border-left: 4px solid #16a34a;
      padding: 14px 18px;
      border-radius: 12px;
      margin-bottom: 24px;
      font-size: 14px;
      font-weight: 600;
    }

    /* ================= TABLE CARD ================= */
    .table-card {
      background: var(--white);
      border-radius: 18px;
      border: 1px solid var(--border-color);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
      overflow: hidden;
    }

    .table-responsive {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 760px;
    }

    thead th {
      background: #f9fafb;
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 15px 18px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
      white-space: nowrap;
    }

    tbody td {
      padding: 16px 18px;
      border-bottom: 1px solid #f3f4f6;
      font-size: 14px;
      color: var(--text-main);
      vertical-align: middle;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    tbody tr {
      transition: background-color 0.15s ease;
    }

    tbody tr:hover {
      background-color: #fafafa;
    }

    .id-badge {
      display: inline-block;
      background: #f3f4f6;
      color: #374151;
      font-weight: 700;
      font-size: 12.5px;
      padding: 4px 10px;
      border-radius: 8px;
      font-variant-numeric: tabular-nums;
    }

    .car-name {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .car-name strong {
      font-weight: 700;
      color: var(--text-main);
    }

    .car-name span {
      font-size: 13px;
      color: var(--text-muted);
    }

    .kategori-pill {
      display: inline-block;
      background: #f3f4f6;
      color: #4b5563;
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 12.5px;
      font-weight: 600;
      white-space: nowrap;
    }

    .price-cell {
      font-weight: 700;
      color: var(--text-main);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .date-cell {
      font-size: 13px;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .bukti-link {
      display: inline-block;
      border-radius: 10px;
      overflow: hidden;
      border: 1.5px solid var(--border-color);
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .bukti-link:hover {
      transform: translateY(-1px);
      border-color: var(--primary);
      box-shadow: 0 4px 12px rgba(185, 28, 28, 0.18);
    }

    .bukti-thumb {
      width: 92px;
      height: 62px;
      object-fit: cover;
      display: block;
      background: #f3f4f6;
    }

    .badge-sold {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ccfbf1;
      color: #0f766e;
      border: 1px solid #99f6e4;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .badge-sold::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #0d9488;
    }

    /* ================= EMPTY STATE ================= */
    .empty-state {
      background: var(--white);
      padding: 56px 28px;
      text-align: center;
      border-radius: 18px;
      border: 1px solid var(--border-color);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    }

    .empty-state h3 {
      font-size: 17px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 6px;
    }

    .empty-state p {
      font-size: 14px;
      color: var(--text-muted);
    }

    /* ================= RESPONSIVE ================= */
    @media (max-width: 900px) {
      body {
        flex-direction: column;
      }

      .sidebar {
        position: static;
        width: 100%;
        height: auto;
        padding: 20px;
      }

      .sidebar-nav {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .sidebar .logout {
        margin-top: 14px;
      }

      .main-content {
        margin-left: 0;
        padding: 28px 20px 48px;
      }

      .page-header h1 {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-brand">
      <a href="/admin/dashboard" class="brand-title">
        <span class="brand-main">SAMUDERA JAYA</span>
        <span class="brand-sub">GROUP</span>
      </a>
      <h2>Admin Panel</h2>
    </div>

    <nav class="sidebar-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/mobil">Kelola Mobil</a>
      <a href="/admin/mobil/arsip" class="active">Arsip Terjual</a>
      <a href="/admin/promo">Kelola Promo</a>
      <a href="/admin/log">Audit Log</a>
    </nav>

    <a href="/admin/logout" class="logout">Logout</a>
  </aside>

  <main class="main-content">
    <div class="page-header">
      <div>
        <h1>Arsip Mobil Terjual</h1>
        <p class="page-subtitle">Total {arsipRows.length} unit tercatat terjual beserta bukti penjualan.</p>
      </div>
      <a href="/admin/mobil" class="btn-back">&larr; Kembali ke Kelola Mobil</a>
    </div>

    {successMessage && <div class="alert-success" role="status">{successMessage}</div>}

    {arsipRows.length === 0 ? (
      <div class="empty-state">
        <h3>Belum Ada Data Arsip</h3>
        <p>Belum ada data mobil terjual di arsip saat ini.</p>
      </div>
    ) : (
      <div class="table-card">
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>ID Mobil</th>
                <th>Brand & Model</th>
                <th>Kategori</th>
                <th>Harga</th>
                <th>Bukti Penjualan</th>
                <th>Tanggal Terjual</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {arsipRows.map((item) => (
                <tr>
                  <td><span class="id-badge">#{item.id_mobil}</span></td>
                  <td>
                    <div class="car-name">
                      <strong>{item.brand_mobil}</strong>
                      <span>{item.model_mobil}</span>
                    </div>
                  </td>
                  <td><span class="kategori-pill">{item.kategori_mobil}</span></td>
                  <td class="price-cell">Rp {Number(item.harga).toLocaleString('id-ID')}</td>
                  <td>
                    <a
                      href={item.bukti_penjualan}
                      target="_blank"
                      rel="noopener noreferrer"
                      title="Lihat ukuran penuh"
                      class="bukti-link"
                    >
                      <img
                        src={item.bukti_penjualan}
                        alt={`Bukti penjualan ${item.brand_mobil} ${item.model_mobil}`}
                        class="bukti-thumb"
                      />
                    </a>
                  </td>
                  <td class="date-cell">{new Date(item.tanggal_terjual).toLocaleString('id-ID')}</td>
                  <td><span class="badge-sold">Terjual</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </main>

</body>
</html>