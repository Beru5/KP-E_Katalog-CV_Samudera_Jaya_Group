// @ts-nocheck
export const prerender = false;
import { pool } from '../../../lib/db.js';
import { catatLog } from '../../../lib/auditLog.js';
import fs from 'node:fs';
import path from 'node:path';

const sessionId = Astro.cookies.get('admin_session')?.value;
if (!sessionId) return Astro.redirect('/admin/login');

const [sessionRows] = await pool.query(`
  SELECT s.*, a.admin_id, a.username FROM Session s 
  JOIN Admin a ON s.admin_id = a.admin_id 
  WHERE s.session_id = ? AND s.expiration_time > NOW()
`, [sessionId]);

if (sessionRows.length === 0) {
  Astro.cookies.delete('admin_session', { path: '/' });
  return Astro.redirect('/admin/login');
}

const currentAdmin = sessionRows[0];
const { id } = Astro.params;

let errorMessage = '';

const [rows] = await pool.query('SELECT * FROM Mobil WHERE id_mobil = ?', [id]);
if (rows.length === 0) return Astro.redirect('/admin/mobil');
const mobil = rows[0];

function removeLocalFiles(imageField) {
  const uploadRoot = path.resolve('./public');
  let list = [];
  try {
    list = JSON.parse(imageField || '[]');
  } catch {
    list = imageField ? [imageField] : [];
  }

  for (const relPath of list) {
    if (typeof relPath === 'string' && relPath.startsWith('/uploads/')) {
      const fullPath = path.join(uploadRoot, relPath);
      if (fs.existsSync(fullPath)) {
        fs.unlinkSync(fullPath);
      }
    }
  }
}

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();

    if (action === 'delete_permanent') {
      const conn = await pool.getConnection();
      try {
        await conn.beginTransaction();

        await conn.query('DELETE FROM Mobil WHERE id_mobil = ?', [id]);

        await catatLog({
          conn,
          admin_id: currentAdmin.admin_id,
          username: currentAdmin.username,
          aksi: 'DELETE_MOBIL_PERMANENT',
          entitas: 'Mobil',
          target_id: id,
          ringkasan: `Hapus permanen (salah input) mobil #${id}: ${mobil.brand_mobil} ${mobil.model_mobil}`,
          data_sebelum: mobil,
          ip_address: Astro.clientAddress
        });

        await conn.commit();
      } catch (txErr) {
        await conn.rollback();
        throw txErr;
      } finally {
        conn.release();
      }

      removeLocalFiles(mobil.gambar_mobil);
      return Astro.redirect('/admin/mobil?status=deleted');
    }

    if (action === 'delete_sold') {
      const buktiFile = formData.get('bukti_penjualan');
      if (!buktiFile || typeof buktiFile !== 'object' || buktiFile.size === 0) {
        throw new Error('Bukti penjualan berupa file gambar wajib diunggah untuk mobil terjual.');
      }

      if (buktiFile.type && !buktiFile.type.startsWith('image/')) {
        throw new Error('File bukti penjualan harus berupa gambar (JPG, PNG, WEBP, dll).');
      }

      const uploadDir = path.resolve('./public/uploads/bukti');
      if (!fs.existsSync(uploadDir)) {
        fs.mkdirSync(uploadDir, { recursive: true });
      }

      const safeName = buktiFile.name.replace(/\s+/g, '_').replace(/[^a-zA-Z0-9._-]/g, '');
      const fileName = `bukti-${Date.now()}-${safeName}`;
      const buffer = Buffer.from(await buktiFile.arrayBuffer());
      fs.writeFileSync(path.join(uploadDir, fileName), buffer);
      const buktiUrl = `/uploads/bukti/${fileName}`;

      const conn = await pool.getConnection();
      try {
        await conn.beginTransaction();

        await conn.query(`
          INSERT INTO Mobil_Terjual (
            id_mobil, brand_mobil, model_mobil, harga, kategori_mobil, transmisi,
            warna_mobil, status_pajak, jumlah_km, tahun_mobil, kapasitas_mesin,
            deskripsi_mobil, gambar_mobil, bukti_penjualan
          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        `, [
          mobil.id_mobil,
          mobil.brand_mobil,
          mobil.model_mobil,
          mobil.harga || 0,
          mobil.kategori_mobil,
          mobil.transmisi,
          mobil.warna_mobil,
          mobil.status_pajak,
          mobil.jumlah_km || 0,
          mobil.tahun_mobil || null,
          mobil.kapasitas_mesin || 0,
          mobil.deskripsi_mobil,
          mobil.gambar_mobil,
          buktiUrl
        ]);

        await conn.query('DELETE FROM Mobil WHERE id_mobil = ?', [id]);

        await catatLog({
          conn,
          admin_id: currentAdmin.admin_id,
          username: currentAdmin.username,
          aksi: 'MARK_MOBIL_SOLD',
          entitas: 'Mobil',
          target_id: id,
          ringkasan: `Menandai terjual & mengarsipkan mobil #${id}: ${mobil.brand_mobil} ${mobil.model_mobil}`,
          data_sebelum: mobil,
          data_sesudah: { status: 'Terjual', bukti_penjualan: buktiUrl },
          ip_address: Astro.clientAddress
        });

        await conn.commit();
      } catch (txErr) {
        await conn.rollback();
        throw txErr;
      } finally {
        conn.release();
      }

      return Astro.redirect('/admin/mobil/arsip?status=sold');
    }

    // Default: Update info mobil
    let brand_mobil = formData.get('brand_mobil')?.toString().trim();
    const brand_lainnya = formData.get('brand_lainnya')?.toString().trim();
    if (brand_mobil === 'Lainnya' && brand_lainnya) {
      brand_mobil = brand_lainnya;
    }

    const model_mobil = formData.get('model_mobil')?.toString().trim();
    const harga = Number(formData.get('harga')) || 0;

    const rawKm = formData.get('jumlah_km')?.toString().replace(/\./g, '') || '0';
    const jumlah_km = Number(rawKm) || 0;

    const tahun_mobil = Number(formData.get('tahun_mobil')) || new Date().getFullYear();
    const kapasitas_mesin = Number(formData.get('kapasitas_mesin')) || 0;
    const digit_tampil = Number(formData.get('digit_tampil')) || 3;

    const kategori_mobil = formData.get('kategori_mobil')?.toString().trim();
    const transmisi = formData.get('transmisi')?.toString().trim();
    const warna_mobil = formData.get('warna_mobil')?.toString().trim();
    const status_pajak = formData.get('status_pajak')?.toString().trim();
    const deskripsi_mobil = formData.get('deskripsi_mobil')?.toString().trim();

    if (isNaN(harga) || isNaN(jumlah_km) || isNaN(tahun_mobil) || isNaN(kapasitas_mesin) || isNaN(digit_tampil)) {
      throw new Error("Harga, Jumlah KM, Tahun, Kapasitas Mesin, dan Digit Depan Harga harus berupa angka yang valid.");
    }

    const imageFiles = formData.getAll('gambar_mobil');
    let gambar_mobil_json = mobil.gambar_mobil;

    const validFiles = imageFiles.filter(f => f && typeof f === 'object' && f.size > 0);
    if (validFiles.length > 0) {
      const uploadDir = path.resolve('./public/uploads');
      if (!fs.existsSync(uploadDir)) {
        fs.mkdirSync(uploadDir, { recursive: true });
      }
      const savedFileNames = [];
      for (const file of validFiles) {
        const buffer = Buffer.from(await file.arrayBuffer());
        const fileName = `${Date.now()}-${file.name.replace(/\s+/g, '_')}`;
        fs.writeFileSync(path.join(uploadDir, fileName), buffer);
        savedFileNames.push(`/uploads/${fileName}`);
      }
      gambar_mobil_json = JSON.stringify(savedFileNames);
    }

    const conn = await pool.getConnection();
    try {
      await conn.beginTransaction();

      await conn.query(`
        UPDATE Mobil 
        SET brand_mobil=?, model_mobil=?, harga=?, kategori_mobil=?, transmisi=?, warna_mobil=?, status_pajak=?, jumlah_km=?, tahun_mobil=?, kapasitas_mesin=?, digit_tampil=?, deskripsi_mobil=?, gambar_mobil=?
        WHERE id_mobil=?
      `, [brand_mobil, model_mobil, harga, kategori_mobil, transmisi, warna_mobil, status_pajak, jumlah_km, tahun_mobil, kapasitas_mesin, digit_tampil, deskripsi_mobil, gambar_mobil_json, id]);

      await catatLog({
        conn,
        admin_id: currentAdmin.admin_id,
        username: currentAdmin.username,
        aksi: 'UPDATE_MOBIL',
        entitas: 'Mobil',
        target_id: id,
        ringkasan: `Memperbarui data mobil #${id}: ${brand_mobil} ${model_mobil}`,
        data_sebelum: mobil,
        data_sesudah: {
          id_mobil: Number(id),
          brand_mobil,
          model_mobil,
          harga,
          kategori_mobil,
          transmisi,
          warna_mobil,
          status_pajak,
          jumlah_km,
          tahun_mobil,
          kapasitas_mesin,
          digit_tampil,
          deskripsi_mobil,
          gambar_mobil: gambar_mobil_json
        },
        ip_address: Astro.clientAddress
      });

      await conn.commit();
    } catch (txErr) {
      await conn.rollback();
      throw txErr;
    } finally {
      conn.release();
    }

    return Astro.redirect('/admin/mobil');
  } catch (err) {
    console.error('DETAIL ERROR UPDATE/DELETE MOBIL:', err);
    errorMessage = `Gagal memproses data: ${err.message || 'Terjadi kesalahan pada database.'}`;
  }
}

const standardBrands = ['Toyota', 'Honda', 'Suzuki', 'Daihatsu', 'Mitsubishi', 'Hyundai', 'Wuling'];
const isStandardBrand = standardBrands.includes(mobil.brand_mobil);

let currentImages = [];
try {
  currentImages = JSON.parse(mobil.gambar_mobil || '[]');
} catch {
  currentImages = mobil.gambar_mobil ? [mobil.gambar_mobil] : [];
}
