<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Mobil - Admin Panel | Samudera Jaya Group</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --primary: #b91c1c;
      --primary-hover: #991b1b;
      --primary-dark: #450a0a;
      --bg-page: #f8f9fa;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --border-color: #e5e7eb;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      line-height: 1.5;
    }

    /* ================= SIDEBAR ================= */
    .sidebar {
      width: 260px;
      background: linear-gradient(180deg, #2b0606 0%, #140808 100%);
      color: var(--white);
      height: 100vh;
      padding: 28px 20px;
      position: fixed;
      top: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      z-index: 100;
    }

    .sidebar-brand {
      padding-bottom: 22px;
      margin-bottom: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .brand-title {
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-decoration: none;
    }

    .brand-title .brand-main {
      font-size: 18px;
      font-weight: 800;
      color: #ef4444;
      letter-spacing: 0.5px;
    }

    .brand-title .brand-sub {
      font-size: 13px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 1.8px;
    }

    .sidebar h2 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: rgba(255, 255, 255, 0.45);
      margin-top: 12px;
      font-weight: 700;
    }

    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .sidebar a {
      color: rgba(255, 255, 255, 0.75);
      text-decoration: none;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.08);
      color: var(--white);
    }

    .sidebar a.active {
      background-color: var(--primary);
      color: var(--white);
      box-shadow: 0 4px 12px rgba(185, 28, 28, 0.35);
    }

    .sidebar .logout {
      margin-top: auto;
      color: #fca5a5;
      background-color: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
      justify-content: center;
    }

    .sidebar .logout:hover {
      background-color: #dc2626;
      color: var(--white);
      border-color: #dc2626;
    }

    /* ================= MAIN CONTENT ================= */
    .main-content {
      margin-left: 260px;
      flex: 1;
      padding: 40px 48px 64px;
      min-width: 0;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      flex-wrap: wrap;
      padding-bottom: 24px;
      margin-bottom: 28px;
      border-bottom: 1px solid var(--border-color);
      max-width: 860px;
    }

    .page-header h1 {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.5px;
    }

    .page-subtitle {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 16px;
      border-radius: 10px;
      background: var(--white);
      border: 1.5px solid var(--border-color);
      color: var(--text-main);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .btn-back:hover {
      background: #f3f4f6;
      border-color: #d1d5db;
    }

    /* ================= FORM CARD ================= */
    .form-card {
      background: var(--white);
      padding: 32px;
      border-radius: 18px;
      border: 1px solid var(--border-color);
      max-width: 860px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    }

    .error {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
      border-left: 4px solid var(--primary);
      padding: 13px 16px;
      border-radius: 10px;
      margin-bottom: 22px;
      font-size: 13.5px;
      font-weight: 600;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    .form-group.hidden {
      display: none;
    }

    .form-group label {
      display: block;
      margin-bottom: 7px;
      font-weight: 600;
      font-size: 13px;
      color: var(--text-main);
    }

    .form-control {
      width: 100%;
      padding: 11px 14px;
      border: 1.5px solid var(--border-color);
      border-radius: 10px;
      font-family: inherit;
      font-size: 14px;
      color: var(--text-main);
      background-color: var(--white);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.12);
    }

    .form-control:disabled {
      background-color: #f3f4f6;
      color: var(--text-muted);
      cursor: not-allowed;
      font-weight: 700;
    }

    textarea.form-control {
      resize: vertical;
      min-height: 110px;
      line-height: 1.6;
    }

    input[type="file"].form-control {
      padding: 9px 12px;
      background: #f9fafb;
      cursor: pointer;
    }

    .photo-section {
      background: #f9fafb;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 16px;
    }

    .preview-container {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }

    .preview-container img {
      width: 96px;
      height: 70px;
      object-fit: cover;
      border-radius: 8px;
      border: 1.5px solid var(--border-color);
      background: var(--white);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .field-hint {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 8px;
      display: block;
    }

    .form-actions {
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px solid var(--border-color);
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .btn-submit {
      background: var(--primary);
      color: var(--white);
      border: none;
      padding: 13px 24px;
      border-radius: 10px;
      cursor: pointer;
      font-family: inherit;
      font-weight: 700;
      width: 100%;
      font-size: 15px;
      box-shadow: 0 6px 16px rgba(185, 28, 28, 0.25);
      transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }

    .btn-submit:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(185, 28, 28, 0.32);
    }

    /* ================= DANGER ZONE ================= */
    .danger-zone {
      margin-top: 24px;
      max-width: 860px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 16px;
      padding: 22px 26px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .danger-info h3 {
      font-size: 16px;
      font-weight: 800;
      color: #991b1b;
      margin-bottom: 4px;
    }

    .danger-info p {
      font-size: 13px;
      color: #7f1d1d;
      max-width: 540px;
    }

    .btn-delete-open {
      background: #dc2626;
      color: var(--white);
      border: none;
      padding: 11px 18px;
      border-radius: 10px;
      font-family: inherit;
      font-weight: 700;
      cursor: pointer;
      font-size: 13.5px;
      white-space: nowrap;
      transition: background-color 0.2s ease, transform 0.15s ease;
    }

    .btn-delete-open:hover {
      background: #b91c1c;
      transform: translateY(-1px);
    }

    /* ================= MODAL ================= */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(17, 24, 39, 0.6);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 16px;
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal-box {
      background: var(--white);
      width: 100%;
      max-width: 500px;
      border-radius: 18px;
      padding: 26px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
      border: 1px solid var(--border-color);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 14px;
      margin-bottom: 16px;
      border-bottom: 1px solid var(--border-color);
    }

    .modal-header h3 {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-main);
    }

    .modal-close {
      background: #f3f4f6;
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      font-size: 20px;
      line-height: 1;
      cursor: pointer;
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .modal-close:hover {
      background: #e5e7eb;
      color: var(--text-main);
    }

    .modal-lead {
      font-size: 14px;
      color: #4b5563;
    }

    .option-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 18px 0;
    }

    .option-card {
      border: 1.5px solid var(--border-color);
      border-radius: 12px;
      padding: 14px;
      cursor: pointer;
      display: flex;
      gap: 12px;
      align-items: flex-start;
      transition: all 0.2s ease;
    }

    .option-card:hover {
      border-color: #d1d5db;
      background: #fafafa;
    }

    .option-card:has(input:checked) {
      border-color: var(--primary);
      background: #fef2f2;
    }

    .option-card input {
      margin-top: 3px;
      accent-color: var(--primary);
      width: 16px;
      height: 16px;
    }

    .option-title {
      font-weight: 700;
      font-size: 14px;
      color: var(--text-main);
      display: block;
      margin-bottom: 2px;
    }

    .option-desc {
      font-size: 12.5px;
      color: var(--text-muted);
      display: block;
    }

    .sold-box {
      display: none;
      background: #f0fdfa;
      border: 1px solid #99f6e4;
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 18px;
    }

    .sold-box.show {
      display: block;
    }

    .sold-box label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 8px;
      color: #115e59;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
    }

    .btn-cancel {
      background: var(--white);
      color: var(--text-main);
      border: 1.5px solid var(--border-color);
      padding: 10px 18px;
      border-radius: 10px;
      font-family: inherit;
      font-weight: 600;
      font-size: 13.5px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-cancel:hover {
      background: #f3f4f6;
    }

    .btn-confirm-perm {
      background: #dc2626;
      color: var(--white);
      border: none;
      padding: 10px 18px;
      border-radius: 10px;
      font-family: inherit;
      font-weight: 700;
      font-size: 13.5px;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .btn-confirm-perm:hover {
      background: #b91c1c;
    }

    .btn-confirm-sold {
      background: #0f766e;
      color: var(--white);
      border: none;
      padding: 10px 18px;
      border-radius: 10px;
      font-family: inherit;
      font-weight: 700;
      font-size: 13.5px;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .btn-confirm-sold:hover {
      background: #115e59;
    }

    /* ================= RESPONSIVE ================= */
    @media (max-width: 900px) {
      body {
        flex-direction: column;
      }

      .sidebar {
        position: static;
        width: 100%;
        height: auto;
        padding: 20px;
      }

      .sidebar-nav {
        flex-direction: row;
        flex-wrap: wrap;
      }

      .sidebar .logout {
        margin-top: 14px;
      }

      .main-content {
        margin-left: 0;
        padding: 28px 20px 48px;
      }

      .page-header h1 {
        font-size: 24px;
      }
    }

    @media (max-width: 640px) {
      .form-card {
        padding: 22px 18px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .danger-zone {
        padding: 18px;
      }

      .btn-delete-open {
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-brand">
      <a href="/admin/dashboard" class="brand-title">
        <span class="brand-main">SAMUDERA JAYA</span>
        <span class="brand-sub">GROUP</span>
      </a>
      <h2>Admin Panel</h2>
    </div>

    <nav class="sidebar-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/mobil" class="active">Kelola Mobil</a>
      <a href="/admin/mobil/arsip">Arsip Terjual</a>
      <a href="/admin/promo">Kelola Promo</a>
      <a href="/admin/log">Audit Log</a>
    </nav>

    <a href="/admin/logout" class="logout">Logout</a>
  </aside>

  <main class="main-content">
    <div class="page-header">
      <div>
        <h1>Edit Info Mobil</h1>
        <p class="page-subtitle">Unit #{mobil.id_mobil} &bull; {mobil.brand_mobil} {mobil.model_mobil}</p>
      </div>
      <a href="/admin/mobil" class="btn-back">&larr; Kembali ke Kelola Mobil</a>
    </div>

    <div class="form-card">
      {errorMessage && <div class="error" role="alert">{errorMessage}</div>}
      <form method="POST" enctype="multipart/form-data">
        <input type="hidden" name="action" value="update" />

        <div class="form-grid">
          <div class="form-group">
            <label>ID Mobil</label>
            <input type="text" class="form-control" value={mobil.id_mobil} disabled />
          </div>

          <div class="form-group">
            <label for="brandSelect">Brand Mobil</label>
            <select id="brandSelect" name="brand_mobil" class="form-control" required>
              <option value="Toyota" selected={mobil.brand_mobil === 'Toyota'}>Toyota</option>
              <option value="Honda" selected={mobil.brand_mobil === 'Honda'}>Honda</option>
              <option value="Suzuki" selected={mobil.brand_mobil === 'Suzuki'}>Suzuki</option>
              <option value="Daihatsu" selected={mobil.brand_mobil === 'Daihatsu'}>Daihatsu</option>
              <option value="Mitsubishi" selected={mobil.brand_mobil === 'Mitsubishi'}>Mitsubishi</option>
              <option value="Hyundai" selected={mobil.brand_mobil === 'Hyundai'}>Hyundai</option>
              <option value="Wuling" selected={mobil.brand_mobil === 'Wuling'}>Wuling</option>
              <option value="Lainnya" selected={!isStandardBrand}>Lainnya (Input Manual)</option>
            </select>
          </div>

          <div class={`form-group full-width ${isStandardBrand ? 'hidden' : ''}`} id="brandLainnyaGroup">
            <label for="brandLainnyaInput">Masukkan Brand Lainnya</label>
            <input type="text" id="brandLainnyaInput" name="brand_lainnya" class="form-control" value={isStandardBrand ? '' : mobil.brand_mobil} placeholder="Nama brand..." />
          </div>

          <div class="form-group">
            <label>Model Mobil</label>
            <input type="text" name="model_mobil" class="form-control" value={mobil.model_mobil} required />
          </div>

          <div class="form-group">
            <label>Tahun Mobil</label>
            <input type="number" name="tahun_mobil" class="form-control" value={mobil.tahun_mobil || 2020} min="1990" max="2030" required />
          </div>

          <div class="form-group">
            <label>Harga (Rp)</label>
            <input type="number" name="harga" class="form-control" value={mobil.harga} required />
          </div>

          <div class="form-group">
            <label>Digit Depan Harga yang Ditampilkan</label>
            <input type="number" name="digit_tampil" class="form-control" value={mobil.digit_tampil ?? 3} min="1" max="15" required />
          </div>

          <div class="form-group">
            <label>Kategori Mobil</label>
            <select name="kategori_mobil" class="form-control" required>
              <option value="SUV" selected={mobil.kategori_mobil === 'SUV'}>SUV</option>
              <option value="MPV" selected={mobil.kategori_mobil === 'MPV'}>MPV</option>
              <option value="Sedan" selected={mobil.kategori_mobil === 'Sedan'}>Sedan</option>
              <option value="Hatchback" selected={mobil.kategori_mobil === 'Hatchback'}>Hatchback</option>
              <option value="City Car" selected={mobil.kategori_mobil === 'City Car'}>City Car</option>
            </select>
          </div>

          <div class="form-group">
            <label>Transmisi</label>
            <select name="transmisi" class="form-control">
              <option value="Automatic" selected={mobil.transmisi === 'Automatic'}>Automatic</option>
              <option value="Manual" selected={mobil.transmisi === 'Manual'}>Manual</option>
            </select>
          </div>

          <div class="form-group">
            <label>Kapasitas Mesin / CC (Integer)</label>
            <input type="number" name="kapasitas_mesin" class="form-control" value={mobil.kapasitas_mesin || 1500} min="500" max="10000" step="1" required />
          </div>

          <div class="form-group">
            <label>Jumlah KM</label>
            <input type="number" name="jumlah_km" class="form-control" value={mobil.jumlah_km} />
          </div>

          <div class="form-group">
            <label>Warna Mobil</label>
            <input type="text" name="warna_mobil" class="form-control" value={mobil.warna_mobil} />
          </div>

          <div class="form-group">
            <label>Status Pajak</label>
            <select name="status_pajak" class="form-control" required>
              <option value="Hidup" selected={mobil.status_pajak === 'Hidup'}>Hidup</option>
              <option value="Mati" selected={mobil.status_pajak === 'Mati'}>Mati</option>
            </select>
          </div>

          <div class="form-group full-width">
            <label>Foto Mobil</label>
            <div class="photo-section">
              {currentImages.length > 0 && (
                <div class="preview-container">
                  {currentImages.map(img => (
                    <img src={img} alt="Foto Mobil" />
                  ))}
                </div>
              )}
              <span class="field-hint">Ganti Foto (Opsional &mdash; biarkan kosong jika tidak ingin mengubah foto saat ini)</span>
              <input type="file" name="gambar_mobil" class="form-control" multiple accept="image/*" />
            </div>
          </div>

          <div class="form-group full-width">
            <label>Deskripsi Mobil</label>
            <textarea name="deskripsi_mobil" class="form-control" rows="4">{mobil.deskripsi_mobil}</textarea>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-submit">Perbarui Informasi Mobil</button>
        </div>
      </form>
    </div>

    <div class="danger-zone">
      <div class="danger-info">
        <h3>Hapus / Arsipkan Mobil</h3>
        <p>Pilih apakah mobil dihapus karena salah input (permanen) atau sudah terjual (masuk arsip dengan bukti gambar).</p>
      </div>
      <button type="button" class="btn-delete-open" onclick="openDeleteModal()">Hapus / Tandai Terjual</button>
    </div>
  </main>

  <!-- Modal Pilihan Delete -->
  <div id="deleteModal" class="modal-backdrop">
    <div class="modal-box">
      <div class="modal-header">
        <h3>Hapus Data Mobil</h3>
        <button type="button" class="modal-close" onclick="closeDeleteModal()">&times;</button>
      </div>
      <p class="modal-lead">
        Pilih alasan penghapusan untuk <strong>{mobil.brand_mobil} {mobil.model_mobil}</strong>:
      </p>

      <form method="POST" enctype="multipart/form-data" id="deleteForm">
        <input type="hidden" name="action" id="deleteActionInput" value="delete_permanent" />

        <div class="option-group">
          <label class="option-card">
            <input type="radio" name="delete_mode" value="permanent" checked onchange="toggleDeleteMode()" />
            <span>
              <span class="option-title">Salah Input / Hapus Permanen</span>
              <span class="option-desc">Menghapus data secara permanen dari sistem (tidak masuk ke arsip terjual).</span>
            </span>
          </label>

          <label class="option-card">
            <input type="radio" name="delete_mode" value="sold" onchange="toggleDeleteMode()" />
            <span>
              <span class="option-title">Mobil Terjual (Pindahkan ke Arsip)</span>
              <span class="option-desc">Memindahkan data ke halaman arsip terjual dan wajib menyertakan bukti gambar.</span>
            </span>
          </label>
        </div>

        <div id="soldProofBox" class="sold-box">
          <label for="buktiInput">Bukti Penjualan (File Gambar Wajib)</label>
          <input type="file" id="buktiInput" name="bukti_penjualan" class="form-control" accept="image/*" />
          <small style="color:#0f766e; display:block; margin-top:6px;">Contoh: foto kwitansi, nota serah terima, atau bukti transfer.</small>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Batal</button>
          <button type="submit" id="confirmBtn" class="btn-confirm-perm">Hapus Permanen</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const brandSelect = document.getElementById('brandSelect') as HTMLSelectElement | null;
    const brandLainnyaGroup = document.getElementById('brandLainnyaGroup') as HTMLElement | null;
    const brandLainnyaInput = document.getElementById('brandLainnyaInput') as HTMLInputElement | null;

    function toggleBrandLainnya() {
      if (!brandSelect || !brandLainnyaGroup || !brandLainnyaInput) return;
      if (brandSelect.value === 'Lainnya') {
        brandLainnyaGroup.classList.remove('hidden');
        brandLainnyaInput.required = true;
      } else {
        brandLainnyaGroup.classList.add('hidden');
        brandLainnyaInput.required = false;
      }
    }

    toggleBrandLainnya();
    if (brandSelect) {
      brandSelect.addEventListener('change', toggleBrandLainnya);
    }

    const modal = document.getElementById('deleteModal') as HTMLElement | null;
    const soldProofBox = document.getElementById('soldProofBox') as HTMLElement | null;
    const buktiInput = document.getElementById('buktiInput') as HTMLInputElement | null;
    const confirmBtn = document.getElementById('confirmBtn') as HTMLButtonElement | null;
    const deleteForm = document.getElementById('deleteForm') as HTMLFormElement | null;
    const deleteActionInput = document.getElementById('deleteActionInput') as HTMLInputElement | null;

    function openDeleteModal() {
      if (!modal || !deleteForm || !buktiInput) return;
      const permRadio = deleteForm.querySelector('input[value="permanent"]') as HTMLInputElement | null;
      if (permRadio) permRadio.checked = true;
      buktiInput.value = '';
      toggleDeleteMode();
      modal.classList.add('show');
    }

    function closeDeleteModal() {
      if (!modal) return;
      modal.classList.remove('show');
    }

    function toggleDeleteMode() {
      if (!deleteForm || !soldProofBox || !buktiInput || !confirmBtn || !deleteActionInput) return;
      const selectedRadio = deleteForm.querySelector('input[name="delete_mode"]:checked') as HTMLInputElement | null;
      const selected = selectedRadio ? selectedRadio.value : 'permanent';

      if (selected === 'sold') {
        deleteActionInput.value = 'delete_sold';
        soldProofBox.classList.add('show');
        buktiInput.required = true;
        confirmBtn.textContent = 'Simpan ke Arsip Terjual';
        confirmBtn.className = 'btn-confirm-sold';
      } else {
        deleteActionInput.value = 'delete_permanent';
        soldProofBox.classList.remove('show');
        buktiInput.required = false;
        confirmBtn.textContent = 'Hapus Permanen';
        confirmBtn.className = 'btn-confirm-perm';
      }
    }

    if (deleteForm) {
      deleteForm.addEventListener('submit', (e) => {
        const selectedRadio = deleteForm.querySelector('input[name="delete_mode"]:checked') as HTMLInputElement | null;
        const selected = selectedRadio ? selectedRadio.value : 'permanent';

        if (selected === 'sold') {
          if (!buktiInput || !buktiInput.files || buktiInput.files.length === 0) {
            e.preventDefault();
            alert('Silakan pilih file gambar bukti penjualan terlebih dahulu.');
            return;
          }
          if (!confirm('Tandai mobil ini sebagai TERJUAL dan pindahkan ke halaman arsip?')) {
            e.preventDefault();
          }
        } else {
          if (!confirm('Yakin ingin menghapus data ini secara permanen karena salah input?')) {
            e.preventDefault();
          }
        }
      });
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeDeleteModal();
      });
    }

    (window as unknown as {
      openDeleteModal: () => void;
      closeDeleteModal: () => void;
      toggleDeleteMode: () => void;
    }).openDeleteModal = openDeleteModal;

    (window as unknown as { closeDeleteModal: () => void }).closeDeleteModal = closeDeleteModal;
    (window as unknown as { toggleDeleteMode: () => void }).toggleDeleteMode = toggleDeleteMode;
  </script>
</body>
</html>