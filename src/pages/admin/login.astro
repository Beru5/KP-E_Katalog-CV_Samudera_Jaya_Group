---
// @ts-nocheck
export const prerender = false; 

import { pool } from '../../lib/db.js';
import crypto from 'crypto';

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const contentType = Astro.request.headers.get('content-type') || '';
    
    let username = '';
    let password = '';

    if (contentType.includes('application/x-www-form-urlencoded') || contentType.includes('multipart/form-data')) {
      const formData = await Astro.request.formData();
      username = formData.get('username');
      password = formData.get('password');
    } else {
      const body = await Astro.request.json();
      username = body.username;
      password = body.password;
    }

    const [rows] = await pool.query('SELECT * FROM Admin WHERE username = ? AND password = ?', [username, password]);
    
    if (rows.length > 0) {
      const admin = rows[0];
      const sessionId = crypto.randomUUID();
      const expiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000);

      // Hapus semua session yang sudah expired sebelum membuat session baru
      await pool.query('DELETE FROM Session WHERE expiration_time <= NOW()');

      await pool.query('INSERT INTO Session (session_id, admin_id, expiration_time) VALUES (?, ?, ?)', [
        sessionId,
        admin.admin_id,
        expiresAt
      ]);

      Astro.cookies.set('admin_session', sessionId, {
        path: '/',
        httpOnly: true,
        secure: Astro.url.protocol === 'https:',
        sameSite: 'strict',
        expires: expiresAt
      });

      return Astro.redirect('/admin/dashboard');
    } else {
      errorMessage = 'Username atau password salah!';
    }
  } catch (err) {
    console.error(err);
    errorMessage = 'Terjadi kesalahan pada server.';
  }
}
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login Admin - CV Samudera Jaya Group</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --primary: #b91c1c;
      --primary-hover: #991b1b;
      --primary-dark: #450a0a;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --border-color: #e5e7eb;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px;
      background: radial-gradient(circle at top right, #450a0a 0%, #2b0606 42%, #140808 100%);
      color: var(--text-main);
      line-height: 1.5;
    }

    .login-wrapper {
      width: 100%;
      max-width: 420px;
    }

    .login-card {
      background: var(--white);
      border-radius: 20px;
      padding: 40px 36px 36px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
      overflow: hidden;
    }

    .login-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: linear-gradient(90deg, #dc2626 0%, #991b1b 100%);
    }

    .brand-header {
      text-align: center;
      padding-bottom: 24px;
      margin-bottom: 26px;
      border-bottom: 1px solid var(--border-color);
    }

    .brand-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--primary);
      background: #fef2f2;
      border: 1px solid #fecaca;
      padding: 4px 12px;
      border-radius: 999px;
      margin-bottom: 12px;
    }

    .brand-name {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      margin-bottom: 8px;
    }

    .brand-main {
      font-size: 22px;
      font-weight: 800;
      color: var(--primary);
      letter-spacing: 0.4px;
      line-height: 1.2;
    }

    .brand-sub {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-main);
      letter-spacing: 2px;
    }

    .login-subtitle {
      font-size: 13.5px;
      color: var(--text-muted);
    }

    .error {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
      border-left: 4px solid var(--primary);
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 13.5px;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      margin-bottom: 7px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
    }

    .input-wrap {
      position: relative;
    }

    .form-control {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid var(--border-color);
      border-radius: 10px;
      font-family: inherit;
      font-size: 14px;
      color: var(--text-main);
      background: var(--white);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control::placeholder {
      color: #9ca3af;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.14);
    }

    .form-control.has-toggle {
      padding-right: 72px;
    }

    .toggle-password {
      position: absolute;
      top: 50%;
      right: 10px;
      transform: translateY(-50%);
      background: #f3f4f6;
      border: 1px solid var(--border-color);
      color: #4b5563;
      font-family: inherit;
      font-size: 11.5px;
      font-weight: 600;
      padding: 5px 9px;
      border-radius: 7px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .toggle-password:hover {
      background: #e5e7eb;
      color: var(--text-main);
    }

    .btn-login {
      margin-top: 6px;
      background: var(--primary);
      color: var(--white);
      border: none;
      padding: 13px 18px;
      border-radius: 10px;
      width: 100%;
      cursor: pointer;
      font-family: inherit;
      font-weight: 700;
      font-size: 15px;
      letter-spacing: 0.2px;
      box-shadow: 0 8px 20px rgba(185, 28, 28, 0.28);
      transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }

    .btn-login:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(185, 28, 28, 0.35);
    }

    .btn-login:active {
      transform: translateY(0);
    }

    .login-footer {
      margin-top: 22px;
      text-align: center;
      font-size: 12.5px;
      color: rgba(255, 255, 255, 0.55);
    }

    .login-footer a {
      color: #fca5a5;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .login-footer a:hover {
      color: var(--white);
    }

    @media (max-width: 480px) {
      .login-card {
        padding: 32px 24px 28px;
        border-radius: 16px;
      }

      .brand-main {
        font-size: 20px;
      }
    }
  </style>
</head>
<body>

  <div class="login-wrapper">
    <div class="login-card">
      <div class="brand-header">
        <span class="brand-badge">Admin Panel</span>
        <div class="brand-name">
          <span class="brand-main">SAMUDERA JAYA</span>
          <span class="brand-sub">GROUP</span>
        </div>
        <p class="login-subtitle">Masuk untuk mengelola katalog mobil, promo, dan audit log.</p>
      </div>

      {errorMessage && <div class="error" role="alert">{errorMessage}</div>}

      <form method="POST" action="/admin/login">
        <div class="form-group">
          <label for="usernameInput">Username</label>
          <input
            type="text"
            id="usernameInput"
            name="username"
            class="form-control"
            placeholder="Masukkan username admin"
            autocomplete="username"
            required
          />
        </div>

        <div class="form-group">
          <label for="passwordInput">Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="passwordInput"
              name="password"
              class="form-control has-toggle"
              placeholder="Masukkan password"
              autocomplete="current-password"
              required
            />
            <button type="button" id="togglePasswordBtn" class="toggle-password">Lihat</button>
          </div>
        </div>

        <button type="submit" class="btn-login">Masuk ke Panel Admin</button>
      </form>
    </div>

    <div class="login-footer">
      <a href="/">&larr; Kembali ke Halaman Utama</a>
    </div>
  </div>

  <script>
    const passwordInput = document.getElementById('passwordInput');
    const toggleBtn = document.getElementById('togglePasswordBtn');

    if (passwordInput && toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const isPassword = passwordInput.getAttribute('type') === 'password';
        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
        toggleBtn.textContent = isPassword ? 'Sembunyi' : 'Lihat';
      });
    }
  </script>
</body>
</html>