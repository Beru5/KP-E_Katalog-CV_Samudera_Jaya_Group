---
// @ts-nocheck
export const prerender = false;
import { pool } from '../../lib/db.js';

const { id } = Astro.params;

let mobil = null;
try {
  const [rows] = await pool.query('SELECT * FROM Mobil WHERE id_mobil = ?', [id]);
  const dataMobil = rows;

  if (dataMobil && dataMobil.length > 0) {
    mobil = dataMobil[0];
  }
} catch (error) {
  console.error("Gagal mengambil detail mobil:", error);
}

if (!mobil) {
  return Astro.redirect('/404');
}

let images = [];
try {
  images = JSON.parse(mobil.gambar_mobil || '[]');
} catch {
  images = mobil.gambar_mobil ? [mobil.gambar_mobil] : [`/${mobil.id_mobil}.png`];
}
if (images.length === 0) {
  images = [`/${mobil.id_mobil}.png`];
}
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Detail {mobil.brand_mobil} {mobil.model_mobil} | Samudera Jaya Group</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --primary: #b91c1c;
      --primary-hover: #991b1b;
      --primary-dark: #450a0a;
      --bg-page: #f8f9fa;
      --bg-dark: #140808;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --border-color: #e5e7eb;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.6;
    }

    /* ================= NAVBAR ================= */
    .navbar {
      background: linear-gradient(90deg, #2b0606 0%, #5c0d0d 100%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-logo {
      text-decoration: none;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .brand-logo .brand-main {
      font-size: 20px;
      font-weight: 800;
      color: #ef4444;
      letter-spacing: 0.5px;
    }

    .brand-logo .brand-sub {
      font-size: 16px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 1.5px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      color: rgba(255, 255, 255, 0.8);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.5px;
      transition: color 0.2s ease;
      position: relative;
      padding-bottom: 4px;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--white);
    }

    .nav-links a.active::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background-color: #ef4444;
      border-radius: 2px;
    }

    /* ================= HERO HEADER ================= */
    .page-header {
      background: linear-gradient(135deg, #3b0707 0%, #1a0404 100%);
      color: var(--white);
      padding: 40px 24px 72px;
      border-bottom: 4px solid var(--primary);
    }

    .header-container {
      max-width: 960px;
      margin: 0 auto;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
      text-decoration: none;
      color: rgba(255, 255, 255, 0.75);
      font-size: 14px;
      font-weight: 600;
      transition: color 0.2s ease, transform 0.2s ease;
    }

    .back-link:hover {
      color: var(--white);
      transform: translateX(-4px);
    }

    .header-label {
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #fca5a5;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .page-header h2 {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    /* ================= MAIN CONTENT ================= */
    .main-container {
      max-width: 960px;
      width: 100%;
      margin: -48px auto 0;
      padding: 0 24px 80px;
      flex: 1;
    }

    .detail-container {
      background: var(--white);
      border-radius: 20px;
      border: 1px solid var(--border-color);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    /* ================= SLIDER ================= */
    .detail-slider {
      position: relative;
      width: 100%;
      height: 460px;
      overflow: hidden;
      background: #111827;
      border-bottom: 1px solid var(--border-color);
    }

    .detail-track {
      display: flex;
      height: 100%;
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      width: 100%;
    }

    .detail-slide {
      min-width: 100%;
      height: 100%;
    }

    .detail-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .slider-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(20, 8, 8, 0.7);
      color: var(--white);
      border: 1px solid rgba(255, 255, 255, 0.2);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
      transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .slider-btn:hover {
      background: var(--primary);
      transform: translateY(-50%) scale(1.06);
    }

    .slider-prev {
      left: 18px;
    }

    .slider-next {
      right: 18px;
    }

    /* ================= DETAIL BODY ================= */
    .detail-body {
      padding: 36px 40px 44px;
    }

    .detail-top {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      padding-bottom: 24px;
      margin-bottom: 28px;
      border-bottom: 2px solid #f3f4f6;
    }

    .detail-title-group .category-badge {
      display: inline-block;
      background: #fef2f2;
      color: var(--primary);
      border: 1px solid #fecaca;
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
    }

    .detail-body h1 {
      font-size: 32px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.25;
      margin: 0;
    }

    .price-highlight {
      text-align: right;
    }

    .price-highlight .price-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    .price-highlight .price-value {
      font-size: 28px;
      font-weight: 800;
      color: var(--primary);
    }

    /* ================= INFO TABLE ================= */
    .specs-box {
      background-color: #f9fafb;
      border: 1px solid #f3f4f6;
      border-radius: 14px;
      padding: 8px 24px;
      margin-bottom: 32px;
    }

    .info-table {
      width: 100%;
      border-collapse: collapse;
    }

    .info-table tr:not(:last-child) td {
      border-bottom: 1px solid #e5e7eb;
    }

    .info-table td {
      padding: 14px 0;
      font-size: 15px;
    }

    .info-table td:first-child {
      font-weight: 600;
      color: var(--text-muted);
      width: 38%;
    }

    .info-table td:last-child {
      font-weight: 700;
      color: var(--text-main);
    }

    /* ================= DESCRIPTION ================= */
    .desc-section {
      margin-bottom: 32px;
    }

    .desc-section h3 {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .desc-section h3::before {
      content: '';
      display: inline-block;
      width: 4px;
      height: 20px;
      background-color: var(--primary);
      border-radius: 2px;
    }

    .car-desc {
      line-height: 1.8;
      color: #4b5563;
      font-size: 15px;
      white-space: pre-line;
    }

    /* ================= ACTIONS ================= */
    .action-bar {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      padding-top: 24px;
      border-top: 1px solid #f3f4f6;
    }

    .btn-wishlist {
      flex: 1;
      min-width: 220px;
      background: var(--primary);
      color: var(--white);
      border: none;
      padding: 14px 24px;
      border-radius: 12px;
      cursor: pointer;
      font-family: inherit;
      font-size: 15px;
      font-weight: 700;
      transition: opacity 0.2s ease, transform 0.15s ease;
    }

    .btn-wishlist:hover {
      opacity: 0.92;
      transform: translateY(-2px);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      color: var(--text-main);
      border: 1.5px solid var(--border-color);
      padding: 14px 24px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
      transition: all 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--primary);
      color: var(--primary);
      background: #fef2f2;
    }

    /* ================= FOOTER ================= */
    .footer {
      background-color: var(--bg-dark);
      color: rgba(255, 255, 255, 0.75);
      padding: 56px 24px 28px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .footer-container {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 40px;
      margin-bottom: 40px;
    }

    .footer-col h4 {
      color: var(--white);
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 16px;
    }

    .footer-col p {
      font-size: 14px;
      line-height: 1.7;
      margin-top: 12px;
    }

    .footer-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .footer-links a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: #ef4444;
    }

    .footer-bottom {
      max-width: 1200px;
      margin: 0 auto;
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      text-align: center;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.5);
    }

    /* ================= RESPONSIVE ================= */
    @media (max-width: 768px) {
      .nav-container {
        flex-direction: column;
        gap: 14px;
      }

      .nav-links {
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
      }

      .detail-slider {
        height: 280px;
      }

      .detail-body {
        padding: 24px 20px 32px;
      }

      .detail-body h1 {
        font-size: 24px;
      }

      .price-highlight {
        text-align: left;
      }

      .price-highlight .price-value {
        font-size: 24px;
      }

      .action-bar {
        flex-direction: column;
      }

      .btn-secondary {
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="brand-logo">
        <span class="brand-main">SAMUDERA JAYA</span>
        <span class="brand-sub">GROUP</span>
      </a>
      <ul class="nav-links">
        <li><a href="/">BERANDA</a></li>
        <li><a href="/promo">PROMO</a></li>
        <li><a href="/#pilih-mobil" class="active">BELI MOBIL</a></li>
        <li><a href="/about">ABOUT US</a></li>
        <li><a href="/wishlist">WISHLIST</a></li>
      </ul>
    </div>
  </nav>

  <!-- HERO HEADER -->
  <header class="page-header">
    <div class="header-container">
      <a href="/" class="back-link">&larr; Kembali ke Katalog Utama</a>
      <div class="header-label">Spesifikasi Unit</div>
      <h2>Detail Mobil</h2>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="main-container">
    <div class="detail-container">

      <div class="detail-slider">
        <div class="detail-track" id="detailTrack" data-index="0">
          {images.map((img) => (
            <div class="detail-slide">
              <img src={img} alt={mobil.model_mobil} />
            </div>
          ))}
        </div>
        {images.length > 1 && (
          <>
            <button class="slider-btn slider-prev" id="prevSlideBtn">&#10094;</button>
            <button class="slider-btn slider-next" id="nextSlideBtn">&#10095;</button>
          </>
        )}
      </div>

      <div class="detail-body">
        <div class="detail-top">
          <div class="detail-title-group">
            <span class="category-badge">{mobil.kategori_mobil}</span>
            <h1>{mobil.brand_mobil} {mobil.model_mobil}</h1>
          </div>
          <div class="price-highlight">
            <span class="price-label">Harga Penawaran</span>
            <span class="price-value">Rp {Number(mobil.harga).toLocaleString('id-ID')}</span>
          </div>
        </div>

        <div class="specs-box">
          <table class="info-table">
            <tr><td>Kategori</td><td>{mobil.kategori_mobil}</td></tr>
            <tr><td>Warna</td><td>{mobil.warna_mobil}</td></tr>
            <tr><td>Transmisi</td><td>{mobil.transmisi}</td></tr>
            <tr><td>Harga</td><td><strong>Rp {Number(mobil.harga).toLocaleString('id-ID')}</strong></td></tr>
            <tr><td>Jarak Tempuh</td><td>{Number(mobil.jumlah_km).toLocaleString('id-ID')} km</td></tr>
            <tr><td>Status Pajak</td><td>{mobil.status_pajak}</td></tr>
          </table>
        </div>

        <div class="desc-section">
          <h3>Deskripsi Mobil</h3>
          <p class="car-desc">{mobil.deskripsi_mobil || 'Tidak ada deskripsi.'}</p>
        </div>

        <div class="action-bar">
          <button class="btn-wishlist" id="btnWishlist">Tambahkan ke Wishlist</button>
          <a href="/wishlist" class="btn-secondary">Lihat Wishlist</a>
        </div>
      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-container">
      <div class="footer-col">
        <a href="/" class="brand-logo">
          <span class="brand-main">SAMUDERA JAYA</span>
          <span class="brand-sub">GROUP</span>
        </a>
        <p>Dealer mobil terpercaya di Pontianak, Kalimantan Barat dengan pilihan unit berkualitas, transparan, dan siap pakai untuk kebutuhan berkendara Anda.</p>
      </div>
      <div class="footer-col">
        <h4>Navigasi</h4>
        <ul class="footer-links">
          <li><a href="/">Beranda</a></li>
          <li><a href="/#pilih-mobil">Katalog Mobil</a></li>
          <li><a href="/promo">Promo</a></li>
          <li><a href="/wishlist">Wishlist Saya</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Kontak Kami</h4>
        <ul class="footer-links">
          <li>Jl. A.Yani No. 123, Pontianak, Kalimantan Barat</li>
          <li>0812-3456-7890</li>
          <li>Senin - Sabtu: 08:00 - 17:00 WIB</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; 2026 Samudera Jaya Group. All rights reserved.
    </div>
  </footer>

  <script define:vars={{ mobil }}>
    const track = document.getElementById('detailTrack');
    const prevBtn = document.getElementById('prevSlideBtn');
    const nextBtn = document.getElementById('nextSlideBtn');
    
    if (track && prevBtn && nextBtn) {
      const slides = track.querySelectorAll('.detail-slide');
      let currentIndex = 0;

      function updateSlide(index) {
        if (index < 0) currentIndex = slides.length - 1;
        else if (index >= slides.length) currentIndex = 0;
        else currentIndex = index;

        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }

      nextBtn.addEventListener('click', () => updateSlide(currentIndex + 1));
      prevBtn.addEventListener('click', () => updateSlide(currentIndex - 1));
    }

    const btn = document.getElementById('btnWishlist');

    function updateButtonState() {
      const currentWishlist = JSON.parse(localStorage.getItem('wishlist')) || [];
      const isExist = currentWishlist.some(item => String(item.id_mobil) === String(mobil.id_mobil));

      if (isExist) {
        btn.textContent = 'Sudah di Wishlist';
        btn.style.background = '#2ed573'; 
      } else {
        btn.textContent = 'Tambahkan ke Wishlist';
        btn.style.background = '#ff4757'; 
      }
    }

    updateButtonState();

    btn.addEventListener('click', () => {
      let currentWishlist = JSON.parse(localStorage.getItem('wishlist')) || [];
      const isExist = currentWishlist.some(item => String(item.id_mobil) !== String(mobil.id_mobil));

      if (isExist) {
        currentWishlist = currentWishlist.filter(item => String(item.id_mobil) !== String(mobil.id_mobil));
      } else {
        currentWishlist.push(mobil);
      }

      localStorage.setItem('wishlist', JSON.stringify(currentWishlist));
      updateButtonState();
    });
  </script>

</body>
</html>